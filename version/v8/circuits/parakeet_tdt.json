{
  "version": 2,
  "name": "parakeet_tdt",
  "family": "audio_transducer",
  "flags": {
    "activation": "silu_relu",
    "normalization": "layernorm_batchnorm",
    "feature_layout": "token_major",
    "encoder_layout": "token_major",
    "decoder": "tdt"
  },
  "contract": {
    "audio_frontend": {
      "input_modality": "wav_bytes",
      "container": "riff_wave",
      "sample_encoding": "pcm_s16_le",
      "channels": 1,
      "sample_rate": 16000,
      "preemphasis": 0.97,
      "n_fft": 512,
      "window_length": 400,
      "window": "nonperiodic_hann",
      "hop_length": 160,
      "centering": "constant_zero",
      "mel_bins": 128,
      "mel_scale": "slaney",
      "log_zero_guard": 5.960464477539063e-8,
      "normalization": "per_feature_sample_variance_live_frames",
      "output": "normalized_log_mel"
    },
    "audio_encoder": {
      "stem": "three_stride2_grouped_conv2d_subsampling",
      "subsampling_factor": 8,
      "blocks": 24,
      "position_encoding": "transformer_xl_relative_sinusoidal",
      "attention": "bidirectional_relative",
      "convolution": "pointwise_glu_depthwise_batchnorm_silu_pointwise",
      "macaron_feed_forward_scale": 0.5
    },
    "transducer": {
      "prediction_network": "two_layer_pytorch_ifgo_lstm",
      "joint_activation": "relu",
      "blank_token_id_config_key": "blank_token_id",
      "durations_config_key": "durations",
      "max_symbols_per_step_config_key": "max_symbols_per_step",
      "blank_zero_duration_policy": "advance_one_frame",
      "decoder_state_lifetime": "session"
    },
    "runtime_invariants": {
      "weight_container": "BUMPWGT5",
      "production_kernel_heap_allocation": false,
      "attention_scratch": "one_fp32_score_row_per_head",
      "lstm_scratch": "four_hidden_width_fp32_gates"
    },
    "weight_policy": {
      "ignore": [
        {
          "pattern": "*",
          "reason": "frontend_component_has_no_model_weights",
          "when": {"config_key": "artifact_scope", "equals": "audio_frontend"}
        },
        {
          "pattern": "encoder.layers.*",
          "reason": "subsampling_component_excludes_encoder_blocks",
          "when": {"config_key": "artifact_scope", "equals": "audio_subsampling"}
        },
        {
          "pattern": "encoder_projector.*",
          "reason": "subsampling_component_excludes_encoder_projection",
          "when": {"config_key": "artifact_scope", "equals": "audio_subsampling"}
        },
        {
          "pattern": "decoder.*",
          "reason": "subsampling_component_excludes_transducer_decoder",
          "when": {"config_key": "artifact_scope", "equals": "audio_subsampling"}
        },
        {
          "pattern": "joint.*",
          "reason": "subsampling_component_excludes_transducer_joint",
          "when": {"config_key": "artifact_scope", "equals": "audio_subsampling"}
        },
        {
          "pattern": "encoder.subsampling.*",
          "reason": "encoder_block_component_excludes_subsampling",
          "when": {"config_key": "artifact_scope", "equals": "audio_encoder_block"}
        },
        {
          "pattern": "encoder_projector.*",
          "reason": "encoder_block_component_excludes_encoder_projection",
          "when": {"config_key": "artifact_scope", "equals": "audio_encoder_block"}
        },
        {
          "pattern": "decoder.*",
          "reason": "encoder_block_component_excludes_transducer_decoder",
          "when": {"config_key": "artifact_scope", "equals": "audio_encoder_block"}
        },
        {
          "pattern": "joint.*",
          "reason": "encoder_block_component_excludes_transducer_joint",
          "when": {"config_key": "artifact_scope", "equals": "audio_encoder_block"}
        },
        {
          "pattern": "decoder.*",
          "reason": "generated_encoder_component_excludes_transducer_decoder",
          "when": {"config_key": "artifact_scope", "equals": "audio_encoder"}
        },
        {
          "pattern": "joint.*",
          "reason": "generated_encoder_component_excludes_transducer_joint",
          "when": {"config_key": "artifact_scope", "equals": "audio_encoder"}
        }
      ]
    }
  },
  "kernels": {
    "audio_hann_window": "audio_hann_window_f32",
    "audio_preemphasis": "audio_preemphasis_f32",
    "audio_stft_tables": "audio_stft_precompute_tables_f32",
    "audio_stft": "audio_stft_power_centered_window_f32",
    "audio_mel_filters": "audio_whisper_mel_filters_slaney_f32",
    "audio_log_mel": "audio_log_mel_time_major_f32",
    "audio_feature_normalize": "audio_feature_normalize_per_feature_f32",
    "audio_fastconformer_subsampling": "audio_fastconformer_subsampling_f32",
    "audio_relative_position": "audio_relative_sinusoidal_position_f32",
    "audio_fastconformer_block": "audio_fastconformer_block_f32",
    "audio_encoder_projection": "gemm_nt_f32_llama_production",
    "audio_tdt_embedding": "embedding_forward_fp32",
    "audio_tdt_lstm": "audio_lstm_step_f32",
    "audio_tdt_projection": "gemm_nt_f32_llama_production",
    "audio_tdt_joint_add": "audio_scaled_residual_add_f32",
    "audio_tdt_relu": "audio_relu_inplace_f32",
    "audio_tdt_joint_head": "gemm_nt_f32_llama_production",
    "audio_tdt_argmax": "audio_argmax_first_f32",
    "relative_position": "audio_relative_sinusoidal_position_f32",
    "relative_attention": "audio_conformer_relative_attention_f32",
    "grouped_conv1d": "audio_conv1d_channel_major_grouped_f32",
    "batch_norm": "audio_batch_norm_inference_channel_major_f32",
    "lstm": "audio_lstm_step_f32",
    "scaled_residual_add": "audio_scaled_residual_add_f32",
    "argmax": "audio_argmax_first_f32"
  },
  "activation_buffers": {
    "audio_samples": {"shape": [{"config": "audio_max_source_frames"}]},
    "audio_preemphasized": {"shape": [{"config": "audio_max_source_frames"}]},
    "audio_table_window": {"shape": [{"config": "audio_n_fft"}]},
    "audio_window": {"shape": [{"config": "audio_window_length"}]},
    "audio_cos_table": {"shape": [{"config": "audio_power_bins"}, {"config": "audio_n_fft"}]},
    "audio_sin_table": {"shape": [{"config": "audio_power_bins"}, {"config": "audio_n_fft"}]},
    "audio_power": {"shape": [{"config": "audio_feature_frames"}, {"config": "audio_power_bins"}]},
    "audio_mel_filters": {"shape": [{"config": "audio_feature_channels"}, {"config": "audio_power_bins"}]},
    "audio_features": {"shape": [{"config": "audio_feature_frames"}, {"config": "audio_feature_channels"}]},
    "audio_features_normalized": {"shape": [{"config": "audio_feature_frames"}, {"config": "audio_feature_channels"}]},
    "audio_encoder_tokens": {"shape": [{"config": "audio_subsampling_output_frames"}, {"config": "hidden_size"}]},
    "audio_relative_positions": {"shape": [{"config": "audio_relative_position_frames"}, {"config": "hidden_size"}]},
    "audio_encoder_projected": {"shape": [{"config": "audio_subsampling_output_frames"}, {"config": "audio_encoder_projection_size"}]},
    "audio_tdt_embedding": {"shape": [{"config": "decoder_hidden_size"}]},
    "audio_tdt_lstm_0": {"shape": [{"config": "decoder_hidden_size"}]},
    "audio_tdt_lstm_1": {"shape": [{"config": "decoder_hidden_size"}]},
    "audio_tdt_decoder_projected": {"shape": [{"config": "decoder_hidden_size"}]},
    "audio_tdt_joint_hidden": {"shape": [{"config": "decoder_hidden_size"}]},
    "audio_tdt_logits": {"shape": [{"config": "audio_tdt_joint_output_size"}]},
    "audio_tdt_token_index": {"shape": [1]},
    "audio_tdt_duration_index": {"shape": [1]}
  },
  "activation_bindings": {
    "audio_samples": "audio_samples",
    "audio_preemphasized": "audio_preemphasized",
    "audio_table_window": "audio_table_window",
    "audio_window": "audio_window",
    "audio_cos_table": "audio_cos_table",
    "audio_sin_table": "audio_sin_table",
    "audio_power": "audio_power",
    "audio_mel_filters": "audio_mel_filters",
    "audio_features": "audio_features",
    "audio_features_normalized": "audio_features_normalized",
    "audio_encoder_tokens": "audio_encoder_tokens",
    "audio_relative_positions": "audio_relative_positions",
    "audio_encoder_projected": "audio_encoder_projected",
    "audio_tdt_embedding": "audio_tdt_embedding",
    "audio_tdt_lstm_0": "audio_tdt_lstm_0",
    "audio_tdt_lstm_1": "audio_tdt_lstm_1",
    "audio_tdt_decoder_projected": "audio_tdt_decoder_projected",
    "audio_tdt_joint_hidden": "audio_tdt_joint_hidden",
    "audio_tdt_logits": "audio_tdt_logits",
    "audio_tdt_token_index": "audio_tdt_token_index",
    "audio_tdt_duration_index": "audio_tdt_duration_index"
  },
  "block_configs": {
    "frontend": {"artifact_scope": "audio_frontend"}
  },
  "sequence": ["frontend", "encoder", "transducer"],
  "block_types": {
    "frontend": {
      "sequence": ["header"],
      "header": [
        {
          "id": "wav_decode",
          "op": "audio_wav_decode",
          "params": {"mono_capacity_from_config": "audio_max_source_frames"}
        },
        {
          "id": "preemphasis",
          "op": "audio_preemphasis",
          "params": {
            "frames_from_config": "audio_max_source_frames",
            "preemphasis_coefficient_from_config": "audio_preemphasis_coefficient"
          }
        },
        {
          "id": "hann_window",
          "op": "audio_hann_window",
          "params": {"frames_from_config": "audio_window_length", "periodic": 0}
        },
        {
          "id": "stft_tables",
          "op": "audio_stft_tables",
          "params": {"n_fft_from_config": "audio_n_fft"},
          "graph_slots": {
            "outputs": {
              "window": "audio_table_window",
              "cos_table": "audio_cos_table",
              "sin_table": "audio_sin_table"
            }
          }
        },
        {
          "id": "stft",
          "op": "audio_stft",
          "params": {
            "n_samples_from_config": "audio_max_source_frames",
            "window_length_from_config": "audio_window_length",
            "n_fft_from_config": "audio_n_fft",
            "hop_length_from_config": "audio_hop_length",
            "reflect_padding": 0,
            "n_frames_from_config": "audio_feature_frames"
          },
          "graph_slots": {
            "inputs": {
              "samples": "audio_preemphasized",
              "window": "audio_window",
              "cos_table": "audio_cos_table",
              "sin_table": "audio_sin_table"
            },
            "outputs": {"power": "audio_power"}
          }
        },
        {
          "id": "mel_filters",
          "op": "audio_mel_filters",
          "params": {
            "sample_rate_from_config": "audio_sample_rate",
            "n_fft_from_config": "audio_n_fft",
            "n_mels_from_config": "audio_feature_channels"
          }
        },
        {
          "id": "log_mel",
          "op": "audio_log_mel",
          "params": {
            "frames_from_config": "audio_feature_frames",
            "bins_from_config": "audio_power_bins",
            "channels_from_config": "audio_feature_channels",
            "log_epsilon_from_config": "audio_log_epsilon"
          }
        },
        {
          "id": "feature_normalize",
          "op": "audio_feature_normalize",
          "params": {
            "channels_from_config": "audio_feature_channels",
            "frames_from_config": "audio_feature_frames",
            "normalization_epsilon_from_config": "audio_normalization_epsilon"
          }
        }
      ]
    },
    "encoder": {
      "sequence": ["subsampling", "relative_position", "body", "encoder_projection"],
      "subsampling": [
        {
          "id": "fastconformer_subsampling",
          "op": "audio_fastconformer_subsampling",
          "params": {
            "workspace_bytes_from_config": "audio_subsampling_workspace_bytes",
            "feature_frames_from_config": "audio_feature_frames",
            "live_frames_from_config": "audio_feature_live_frames",
            "feature_channels_from_config": "audio_feature_channels",
            "conv_channels_from_config": "audio_subsampling_conv_channels",
            "hidden_size_from_config": "hidden_size",
            "kernel_size_from_config": "audio_subsampling_kernel_size",
            "stride_from_config": "audio_subsampling_stride",
            "output_capacity_frames_from_config": "audio_subsampling_output_frames"
          },
          "graph_slots": {
            "inputs": {"features": "audio_features_normalized"},
            "outputs": {"output": "audio_encoder_tokens"}
          },
          "weight_refs": {
            "conv0_weight": "encoder.subsampling.layers.0.weight",
            "conv0_bias": "encoder.subsampling.layers.0.bias",
            "depthwise1_weight": "encoder.subsampling.layers.2.weight",
            "depthwise1_bias": "encoder.subsampling.layers.2.bias",
            "pointwise1_weight": "encoder.subsampling.layers.3.weight",
            "pointwise1_bias": "encoder.subsampling.layers.3.bias",
            "depthwise2_weight": "encoder.subsampling.layers.5.weight",
            "depthwise2_bias": "encoder.subsampling.layers.5.bias",
            "pointwise2_weight": "encoder.subsampling.layers.6.weight",
            "pointwise2_bias": "encoder.subsampling.layers.6.bias",
            "linear_weight": "encoder.subsampling.linear.weight",
            "linear_bias": "encoder.subsampling.linear.bias"
          }
        }
      ],
      "relative_position": [
        {
          "id": "relative_position",
          "op": "audio_relative_position",
          "params": {
            "frames_from_config": "audio_subsampling_output_frames",
            "channels_from_config": "hidden_size"
          },
          "graph_slots": {
            "inputs": {},
            "outputs": {"output": "audio_relative_positions"}
          }
        }
      ],
      "body": {
        "ops": [
          {
            "id": "fastconformer_block",
            "op": "audio_fastconformer_block",
            "params": {
              "workspace_bytes_from_config": "audio_fastconformer_block_workspace_bytes",
              "frames_from_config": "audio_subsampling_output_frames",
              "hidden_size_from_config": "hidden_size",
              "intermediate_size_from_config": "intermediate_size",
              "heads_from_config": "num_attention_heads",
              "head_dim_from_config": "head_dim",
              "conv_kernel_size_from_config": "audio_fastconformer_conv_kernel_size",
              "layer_norm_epsilon_from_config": "audio_fastconformer_layer_norm_epsilon",
              "batch_norm_epsilon_from_config": "audio_fastconformer_batch_norm_epsilon"
            },
            "graph_slots": {
              "inputs": {
                "input": "audio_encoder_tokens",
                "relative_positions": "audio_relative_positions"
              },
              "outputs": {"output": "audio_encoder_tokens"}
            },
            "weight_refs": {
              "ff1_norm_weight": "encoder.layers.{L}.norm_feed_forward1.weight",
              "ff1_norm_bias": "encoder.layers.{L}.norm_feed_forward1.bias",
              "ff1_up_weight": "encoder.layers.{L}.feed_forward1.linear1.weight",
              "ff1_up_bias": "encoder.layers.{L}.feed_forward1.linear1.bias",
              "ff1_down_weight": "encoder.layers.{L}.feed_forward1.linear2.weight",
              "ff1_down_bias": "encoder.layers.{L}.feed_forward1.linear2.bias",
              "attn_norm_weight": "encoder.layers.{L}.norm_self_att.weight",
              "attn_norm_bias": "encoder.layers.{L}.norm_self_att.bias",
              "q_weight": "encoder.layers.{L}.self_attn.q_proj.weight",
              "q_bias": "encoder.layers.{L}.self_attn.q_proj.bias",
              "k_weight": "encoder.layers.{L}.self_attn.k_proj.weight",
              "k_bias": "encoder.layers.{L}.self_attn.k_proj.bias",
              "v_weight": "encoder.layers.{L}.self_attn.v_proj.weight",
              "v_bias": "encoder.layers.{L}.self_attn.v_proj.bias",
              "relative_weight": "encoder.layers.{L}.self_attn.relative_k_proj.weight",
              "attn_bias_u": "encoder.layers.{L}.self_attn.bias_u",
              "attn_bias_v": "encoder.layers.{L}.self_attn.bias_v",
              "attn_out_weight": "encoder.layers.{L}.self_attn.o_proj.weight",
              "attn_out_bias": "encoder.layers.{L}.self_attn.o_proj.bias",
              "conv_norm_weight": "encoder.layers.{L}.norm_conv.weight",
              "conv_norm_bias": "encoder.layers.{L}.norm_conv.bias",
              "conv_pw1_weight": "encoder.layers.{L}.conv.pointwise_conv1.weight",
              "conv_pw1_bias": "encoder.layers.{L}.conv.pointwise_conv1.bias",
              "conv_dw_weight": "encoder.layers.{L}.conv.depthwise_conv.weight",
              "conv_dw_bias": "encoder.layers.{L}.conv.depthwise_conv.bias",
              "conv_bn_mean": "encoder.layers.{L}.conv.norm.running_mean",
              "conv_bn_variance": "encoder.layers.{L}.conv.norm.running_var",
              "conv_bn_weight": "encoder.layers.{L}.conv.norm.weight",
              "conv_bn_bias": "encoder.layers.{L}.conv.norm.bias",
              "conv_pw2_weight": "encoder.layers.{L}.conv.pointwise_conv2.weight",
              "conv_pw2_bias": "encoder.layers.{L}.conv.pointwise_conv2.bias",
              "ff2_norm_weight": "encoder.layers.{L}.norm_feed_forward2.weight",
              "ff2_norm_bias": "encoder.layers.{L}.norm_feed_forward2.bias",
              "ff2_up_weight": "encoder.layers.{L}.feed_forward2.linear1.weight",
              "ff2_up_bias": "encoder.layers.{L}.feed_forward2.linear1.bias",
              "ff2_down_weight": "encoder.layers.{L}.feed_forward2.linear2.weight",
              "ff2_down_bias": "encoder.layers.{L}.feed_forward2.linear2.bias",
              "out_norm_weight": "encoder.layers.{L}.norm_out.weight",
              "out_norm_bias": "encoder.layers.{L}.norm_out.bias"
            }
          }
        ]
      },
      "encoder_projection": [
        {
          "id": "encoder_projection",
          "op": "audio_encoder_projection",
          "when": {
            "config_key": "audio_include_encoder_projection",
            "equals": true
          },
          "params": {
            "seq_len_from_config": "audio_subsampling_output_frames",
            "_input_dim_from_config": "hidden_size",
            "_output_dim_from_config": "audio_encoder_projection_size"
          },
          "graph_slots": {
            "inputs": {"A": "audio_encoder_tokens"},
            "outputs": {"C": "audio_encoder_projected"}
          },
          "weight_refs": {
            "weight": "encoder_projector.weight",
            "bias": "encoder_projector.bias"
          }
        }
      ]
    },
    "transducer": {
      "sequence": ["decode"],
      "decode": [
        {
          "id": "tdt_embedding",
          "op": "audio_tdt_embedding",
          "when": {"config_key": "audio_include_tdt_decode", "equals": true},
          "params": {
            "seq_len": 1,
            "vocab_size_from_config": "vocab_size",
            "embed_dim_from_config": "decoder_hidden_size"
          },
          "graph_slots": {
            "inputs": {"tokens": "external:audio_tdt_token"},
            "outputs": {"output": "audio_tdt_embedding"}
          },
          "weight_refs": {"token_emb": "decoder.embedding.weight"}
        },
        {
          "id": "tdt_lstm_0",
          "op": "audio_tdt_lstm",
          "when": {"config_key": "audio_include_tdt_decode", "equals": true},
          "params": {
            "input_size_from_config": "decoder_hidden_size",
            "hidden_size_from_config": "decoder_hidden_size"
          },
          "graph_slots": {
            "inputs": {
              "input": "audio_tdt_embedding",
              "hidden_state_in": "external:audio_tdt_hidden_0",
              "cell_state_in": "external:audio_tdt_cell_0"
            },
            "outputs": {
              "output": "audio_tdt_lstm_0",
              "hidden_state": "external:audio_tdt_hidden_0",
              "cell_state": "external:audio_tdt_cell_0"
            }
          },
          "weight_refs": {
            "weight_ih": "decoder.lstm.weight_ih_l0",
            "weight_hh": "decoder.lstm.weight_hh_l0",
            "bias_ih": "decoder.lstm.bias_ih_l0",
            "bias_hh": "decoder.lstm.bias_hh_l0"
          }
        },
        {
          "id": "tdt_lstm_1",
          "op": "audio_tdt_lstm",
          "when": {"config_key": "audio_include_tdt_decode", "equals": true},
          "params": {
            "input_size_from_config": "decoder_hidden_size",
            "hidden_size_from_config": "decoder_hidden_size"
          },
          "graph_slots": {
            "inputs": {
              "input": "audio_tdt_lstm_0",
              "hidden_state_in": "external:audio_tdt_hidden_1",
              "cell_state_in": "external:audio_tdt_cell_1"
            },
            "outputs": {
              "output": "audio_tdt_lstm_1",
              "hidden_state": "external:audio_tdt_hidden_1",
              "cell_state": "external:audio_tdt_cell_1"
            }
          },
          "weight_refs": {
            "weight_ih": "decoder.lstm.weight_ih_l1",
            "weight_hh": "decoder.lstm.weight_hh_l1",
            "bias_ih": "decoder.lstm.bias_ih_l1",
            "bias_hh": "decoder.lstm.bias_hh_l1"
          }
        },
        {
          "id": "tdt_decoder_projection",
          "op": "audio_tdt_projection",
          "when": {"config_key": "audio_include_tdt_decode", "equals": true},
          "params": {
            "seq_len": 1,
            "_input_dim_from_config": "decoder_hidden_size",
            "_output_dim_from_config": "decoder_hidden_size"
          },
          "graph_slots": {
            "inputs": {"A": "audio_tdt_lstm_1"},
            "outputs": {"C": "audio_tdt_decoder_projected"}
          },
          "weight_refs": {
            "weight": "decoder.decoder_projector.weight",
            "bias": "decoder.decoder_projector.bias"
          }
        },
        {
          "id": "tdt_joint_add",
          "op": "audio_tdt_joint_add",
          "when": {"config_key": "audio_include_tdt_decode", "equals": true},
          "params": {"scale": 1.0, "elements_from_config": "decoder_hidden_size"},
          "graph_slots": {
            "inputs": {
              "residual": "external:audio_tdt_encoder_row",
              "branch": "audio_tdt_decoder_projected"
            },
            "outputs": {"output": "audio_tdt_joint_hidden"}
          }
        },
        {
          "id": "tdt_joint_relu",
          "op": "audio_tdt_relu",
          "when": {"config_key": "audio_include_tdt_decode", "equals": true},
          "params": {"elements_from_config": "decoder_hidden_size"},
          "graph_slots": {
            "inputs": {"input": "audio_tdt_joint_hidden"},
            "outputs": {"output": "audio_tdt_joint_hidden"}
          }
        },
        {
          "id": "tdt_joint_head",
          "op": "audio_tdt_joint_head",
          "when": {"config_key": "audio_include_tdt_decode", "equals": true},
          "params": {
            "seq_len": 1,
            "_input_dim_from_config": "decoder_hidden_size",
            "_output_dim_from_config": "audio_tdt_joint_output_size"
          },
          "graph_slots": {
            "inputs": {"A": "audio_tdt_joint_hidden"},
            "outputs": {"C": "audio_tdt_logits"}
          },
          "weight_refs": {"weight": "joint.head.weight", "bias": "joint.head.bias"}
