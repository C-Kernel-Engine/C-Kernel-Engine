{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cke.v8.kernel_call_abi",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "params"],
  "properties": {
    "version": {"const": 1},
    "last_token_dispatch": {
      "type": "string",
      "enum": ["preserve_provider"],
      "description": "Keep the resolved provider for last-only logits instead of deriving a row GEMV."
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source": {
            "type": "string",
            "pattern": "^(null|(activation|config|const|dim|dtype|dtype_weight|output|param|resolved|runtime|scratch|scratch_size|scratch_elements|weight|weight_f):.+)$"
          },
          "cast": {"type": "string", "minLength": 1},
          "value_type": {"const": "size_t", "description": "Explicitly typed scalar runtime argument eligible for circuit call constants."},
          "ports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(input|weight|output):[^:]+$"
            },
            "description": "Logical operation ports represented by this C argument. Aliased in-place input/output ports share one argument."
          },
          "alt": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
