{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cke.v8.kernel_execution_capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "op", "contract_schema_version", "implementation"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "op": {"type": "string", "minLength": 1},
    "contract_schema_version": {"const": 1},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "priority", "equivalence_group", "phases"],
      "properties": {
        "status": {"enum": ["production", "candidate", "diagnostic", "deprecated"]},
        "priority": {"type": "integer"},
        "equivalence_group": {"type": "string", "minLength": 1},
        "phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["init", "prefill", "decode", "training", "backward"]}
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isa_dispatch", "threading"],
      "properties": {
        "isa_dispatch": {"enum": ["runtime", "compile_time", "scalar"]},
        "query_tiling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selection", "numerical_effect", "key_tile_size", "routes"],
          "properties": {
            "selection": {"const": "token_threshold"},
            "numerical_effect": {"const": "none"},
            "key_tile_size": {"type": "integer", "minimum": 1},
            "routes": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["min_tokens", "max_tokens", "query_tile_size", "function"],
                "properties": {
                  "min_tokens": {"type": "integer", "minimum": 1},
                  "max_tokens": {"type": ["integer", "null"], "minimum": 1},
                  "query_tile_size": {"type": "integer", "minimum": 1},
                  "function": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "work_partition_routing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selection", "numerical_effect", "dispatch_function"],
          "properties": {
            "selection": {"enum": ["shape_threshold", "generated_runtime_dispatch"]},
            "numerical_effect": {"const": "none"},
            "dispatch_function": {"type": "string", "minLength": 1},
            "policy": {"type": "string", "minLength": 1},
            "routes": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "work_partition", "predicate"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "work_partition": {"enum": ["independent_rows", "independent_columns", "output_tiles"]},
                  "predicate": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "min_m": {"type": "integer", "minimum": 1},
                      "max_m": {"type": "integer", "minimum": 1},
                      "min_n": {"type": "integer", "minimum": 1},
                      "max_n": {"type": "integer", "minimum": 1},
                      "min_k": {"type": "integer", "minimum": 1},
                      "max_k": {"type": "integer", "minimum": 1},
                      "fallback": {"const": true}
                    },
                    "minProperties": 1
                  }
                }
              }
            }
          }
        },
        "runtime_dispatch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "policies"],
          "properties": {
            "schema_version": {"const": 1},
            "policies": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "routes"],
                "properties": {
                  "status": {"enum": ["production", "candidate", "production_when_prepared"]},
                  "requires": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "requires_fallback": {"type": "boolean"},
                  "notes": {"type": "string", "minLength": 1},
                  "routes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "m": {"type": "integer", "minimum": 1},
                        "min_m": {"type": "integer", "minimum": 1},
                        "max_m": {"type": "integer", "minimum": 1},
                        "n": {"type": "integer", "minimum": 1},
                        "min_n": {"type": "integer", "minimum": 1},
                        "max_n": {"type": "integer", "minimum": 1},
                        "k": {"type": "integer", "minimum": 1},
                        "min_k": {"type": "integer", "minimum": 1},
                        "max_k": {"type": "integer", "minimum": 1},
                        "tile_m": {"type": "integer", "minimum": 1},
                        "tile_n": {"type": "integer", "minimum": 1},
                        "max_threads": {"type": "integer", "minimum": 1},
                        "flags": {
                          "type": "array",
                          "uniqueItems": true,
                          "items": {"enum": ["output_tiles", "compact_m4", "batched_tail"]}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "weight_storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "block_elements", "block_bytes"],
          "properties": {
            "format": {"type": "string", "minLength": 1},
            "block_elements": {"type": "integer", "minimum": 1},
            "block_bytes": {"type": "integer", "minimum": 1}
          }
        },
        "activation_storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "block_elements"],
          "properties": {
            "format": {"type": "string", "minLength": 1},
            "block_elements": {"type": "integer", "minimum": 1}
          }
        },
        "diagnostic_providers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fp32_activation"],
          "properties": {
            "fp32_activation": {"type": "string", "minLength": 1},
            "row_quantized": {"type": "string", "minLength": 1}
          }
        },
        "segmented_row_provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["function", "segment_lengths_dtype", "boundary_semantics", "fallback"],
          "properties": {
            "function": {"type": "string", "minLength": 1},
            "segment_lengths_dtype": {"const": "i32"},
            "boundary_semantics": {"const": "restart_row_group_at_each_segment"},
            "fallback": {"type": "string", "minLength": 1}
          }
        },
        "segmented_query_provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["function", "segment_lengths_dtype", "boundary_semantics", "fallback"],
          "properties": {
            "function": {"type": "string", "minLength": 1},
            "segment_lengths_dtype": {"const": "i32"},
            "boundary_semantics": {"const": "restart_query_tile_policy_at_each_segment"},
            "fallback": {"type": "string", "minLength": 1}
          }
        },
        "threading": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "work_partition", "dispatch", "reduction_order_effect"],
          "properties": {
            "runtime": {
              "enum": ["serial", "ck_threadpool", "openmp", "external_blas"]
            },
            "work_partition": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": [
                "serial",
                "independent_rows",
                "independent_columns",
                "independent_experts",
                "independent_heads",
                "independent_query_blocks",
                "kv_chunks_by_workers",
                "output_tiles",
                "split_k"
              ]}
            },
            "dispatch": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["inline", "ck_threadpool_dispatch_n", "ck_threadpool_parallel_for_n", "openmp_parallel_for", "internal_threaded"]}
            },
            "schedule": {
              "enum": ["static_partition", "dynamic_work_claim"]
            },
            "barriers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "reduction_order_effect": {"enum": ["none", "contract_defined", "implementation_defined"]}
          }
        }
      }
    }
  }
}
