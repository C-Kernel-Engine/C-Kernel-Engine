#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
VENV_PY="$PROJECT_ROOT/.venv/bin/python"
SYSTEM_PY="${PYTHON3:-python3}"
CONFIGURED_PY="${CK_V8_PYTHON:-${PYTHON:-}}"
GIT_COMMON_DIR="$(git -C "$PROJECT_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
PRIMARY_VENV_PY=""
if [[ "$GIT_COMMON_DIR" == */.git ]]; then
  PRIMARY_VENV_PY="${GIT_COMMON_DIR%/.git}/.venv/bin/python"
fi
REQS="$PROJECT_ROOT/version/v8/requirements.txt"
SELECTED_PY=""

requires_source_integrity() {
  case "${1:-}" in
    run|audio|serve)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

print_run_quickstart() {
  cat <<EOF
[v8] model argument required for 'run'

Quick start:
  version/v8/scripts/cks-v8-run run hf://Qwen/Qwen3-0.6B-GGUF/Qwen3-0.6B-Q8_0.gguf \\
    --context-len 1024 --force-compile --force-convert

Raw CLI examples:
  version/v8/scripts/cks-v8-run run hf://Qwen/Qwen3-0.6B-GGUF/Qwen3-0.6B-Q8_0.gguf \\
    --context-len 1024 --force-compile --force-convert

  version/v8/scripts/cks-v8-run run /path/to/model.gguf \\
    --context-len 1024

  version/v8/scripts/cks-v8-run run hf://Qwen/Qwen3-VL-8B-Instruct-GGUF/Qwen3VL-8B-Instruct-Q4_K_M.gguf \\
    --mmproj hf://Qwen/Qwen3-VL-8B-Instruct-GGUF/mmproj-Qwen3VL-8B-Instruct-Q8_0.gguf \\
    --image-path version/v8/test_assets/v8_vision_doc_card_72.ppm \\
    --prompt "Explain this image."

  version/v8/scripts/cks-v8-run audio \\
    --encoder-run-dir /path/to/whisper-tiny-encoder \\
    --decoder-run-dir /path/to/whisper-tiny-decoder \\
    --wav /path/to/audio.wav

After a run exists:
  ./build/ck-cli-v8 --list

Serve over HTTP/SSE (OpenAI Responses shape):
  version/v8/scripts/cks-v8-run serve hf://Qwen/Qwen3-0.6B-GGUF/Qwen3-0.6B-Q8_0.gguf \\
    --port 8080

Advanced options:
  version/v8/scripts/cks-v8-run run --help
EOF
}

check_python_reqs() {
  local py="$1"
  "$py" - "$REQS" <<'PY'
import importlib.util
import re
import sys
from pathlib import Path

reqs = Path(sys.argv[1])
if not reqs.exists():
    raise SystemExit(0)

packages = []
for raw in reqs.read_text(encoding="utf-8").splitlines():
    line = raw.strip()
    if not line or line.startswith("#") or line.startswith("--") or line.startswith("-e "):
        continue
    if "://" in line:
        continue
    pkg = re.split(r"[<>=!~\[\]\s]", line, maxsplit=1)[0].strip()
    if pkg:
        packages.append(pkg)

missing = [pkg for pkg in packages if importlib.util.find_spec(pkg.replace("-", "_")) is None]
if missing:
    print("\n".join(missing))
    raise SystemExit(1)
PY
}

bootstrap_venv() {
  local bootstrap_py="${PYTHON3:-python3}"
  echo "[v8] creating repo-local .venv"
  "$bootstrap_py" -m venv "$PROJECT_ROOT/.venv"
  "$VENV_PY" -m pip install --upgrade pip
  "$VENV_PY" -m pip install -r "$REQS"
}

select_python_if_ready() {
  local candidate="${1:-}"
  local resolved=""
  if [ -z "$candidate" ]; then
    return 1
  fi
  if [ -x "$candidate" ]; then
    resolved="$candidate"
  elif command -v "$candidate" >/dev/null 2>&1; then
    resolved="$(command -v "$candidate")"
  else
    return 1
  fi
  if check_python_reqs "$resolved" >/dev/null 2>&1; then
    SELECTED_PY="$resolved"
    return 0
  fi
  return 1
}

ensure_bootstrap() {
  local candidate
  for candidate in "$CONFIGURED_PY" "$VENV_PY" "$PRIMARY_VENV_PY" "$SYSTEM_PY"; do
    if select_python_if_ready "$candidate"; then
      return 0
    fi
  done

  echo "[v8] missing repo-local Python environment or required packages."
  echo "[v8] supported bootstrap:"
  echo "      python3 -m venv .venv"
  echo "      .venv/bin/pip install -r version/v8/requirements.txt"

  if [ ! -t 0 ]; then
    echo "[v8] non-interactive shell: refusing to auto-bootstrap."
    exit 1
  fi

  printf "[v8] create .venv and install version/v8/requirements.txt now? [y/N] "
  read -r answer
  case "${answer:-}" in
    y|Y|yes|YES)
      bootstrap_venv
      ;;
    *)
      echo "[v8] bootstrap skipped. Install version/v8/requirements.txt and retry."
      exit 1
      ;;
  esac
}

needs_bootstrap() {
  local cmd="${1:-}"
  local arg
  for arg in "$@"; do
    case "$arg" in
      -h|--help)
        return 1
        ;;
    esac
  done
  case "$cmd" in
    ""|help|list|clean)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

if requires_source_integrity "$@"; then
  "$SYSTEM_PY" "$PROJECT_ROOT/scripts/check_source_integrity.py"
  export CK_SOURCE_INTEGRITY_CHECKED=1
fi

if needs_bootstrap "$@"; then
  ensure_bootstrap
fi

if [ "${1:-}" = "run" ] && [ "$#" -eq 1 ]; then
  print_run_quickstart
  exit 2
fi

if [ -z "${CK_CACHE_DIR:-}" ]; then
  default_cache_dir="$HOME/.cache/ck-engine-v8/models"
  if mkdir -p "$default_cache_dir" >/dev/null 2>&1; then
    export CK_CACHE_DIR="$default_cache_dir"
  else
    export CK_CACHE_DIR="$PROJECT_ROOT/version/v8/.cache/models"
  fi
fi

PY_BIN="python3"
if [ -n "$SELECTED_PY" ]; then
  PY_BIN="$SELECTED_PY"
elif [ -x "$VENV_PY" ]; then
  PY_BIN="$VENV_PY"
fi

if [ "${1:-}" = "serve" ]; then
  exec "$PY_BIN" "$SCRIPT_DIR/ck_serve_v8.py" "${@:2}"
fi

exec "$PY_BIN" "$SCRIPT_DIR/ck_run_v8.py" "$@"
