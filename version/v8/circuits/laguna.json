{
  "version": 2,
  "name": "laguna",
  "family": "laguna",
  "projection_inputs": {
    "q_proj": {"x": "main_stream_q8"},
    "k_proj": {"x": "main_stream_q8"},
    "v_proj": {"x": "main_stream_q8"}
  },
  "flags": {
    "activation": "swiglu",
    "rope": "rope",
    "rope_cache_rotary_dim_config_key": "rotary_dim",
    "tokenizer": "bpe",
    "prefill_policy": "batched",
    "hybrid_block_pattern": "config.layer_kinds"
  },
  "runtime_defaults": {
    "prefill_chunk_length": 4096,
    "logits_layout": "last"
  },
  "activation_bindings": {
    "main_stream": "embedded_input",
    "normalized_stream": "layer_input",
    "attention_residual": "residual",
    "routed_stream": "mlp_scratch"
  },
  "contract": {
    "tokenizer_contract": {
      "tokenizer_type": "bpe",
      "bos_policy": "model_defined",
      "eos_policy": "model_defined",
      "special_tokens": {"source": "manifest_or_gguf"}
    },
    "chat_contract": {
      "version": 1,
      "name": "laguna",
      "raw_prompt_allowed": false,
      "conversation_prefix": "〈|EOS|〉",
      "turn_prefix": "<{role}>",
      "turn_suffix": "</{role}>\n",
      "assistant_generation_prefix": "<assistant><think>",
      "assistant_generation_prefix_by_thinking_mode": {
        "visible": "<assistant><think>",
        "suppressed": "<assistant></think>"
      },
      "role_labels": {"system": "system", "user": "user", "assistant": "assistant"},
      "system_prompt_mode": "dedicated_turn",
      "system_prompt_separator": "\n",
      "default_system_prompt": "You are a helpful, conversationally-fluent assistant made by Poolside. You are here to be helpful to users through natural language conversations.",
      "inject_default_system_prompt": true,
      "thinking_mode_default": "visible",
      "stop_text_markers": ["</assistant>", "〈|EOS|〉"],
      "token_stop_markers": ["〈|EOS|〉"],
      "template_markers": ["<system>", "</system>", "<user>", "</user>", "<assistant>", "</assistant>", "<think>", "</think>", "〈|EOS|〉"],
      "min_response_tokens": 8
    },
    "attention_contract": {
      "attn_variant": "gated_gqa_global_or_sliding",
      "causal": true,
      "rope_layout": "split",
      "rope_type": "yarn_global_or_full_rotary_sliding",
      "qk_norm": true,
      "kv_layout": "layer_major_kv_cache",
      "layer_policy_config_key": "layer_kinds",
      "gate_formula": "softplus(head_gate) * attention_head"
    },
    "block_contract": {
      "norm_type": "rmsnorm",
      "body_type": "dense_first_then_routed_shared_moe",
      "activation": "swiglu",
      "dense_mlp_formula": "gate/up -> SwiGLU -> down",
      "moe_formula": "sigmoid router with correction bias -> top-8 routed SwiGLU plus shared SwiGLU",
      "residual_formula": "attention residual followed by dense or routed-plus-shared MLP residual"
    },
    "logits_contract": {"final_norm": "rmsnorm", "lm_head": "output_weight", "logits_layout": "last"},
    "quant_contract": {"kernel_select": "weight_dtype_registry", "per_tensor_mixed_quant": true},
    "runtime_invariants": {"required_call_args": {}}
  },
  "kernels": {
    "rope_init": "yarn_rope_cache_contiguous_positions_f32",
    "rope_qk": "rope_forward_qk",
    "attn": "attention_forward_causal_head_major_gqa_flash_strided",
    "attn_sliding": "attention_forward_causal_head_major_gqa_flash_strided_sliding",
    "attn_decode": "attention_forward_decode_head_major_gqa_regular",
    "attn_sliding_decode": "attention_forward_decode_head_major_gqa_flash_sliding",
    "attn_gate_softplus_mul": "attn_gate_softplus_mul_forward",
    "group_limited_topk_router": "group_limited_topk_router_sigmoid_f32"
  },
  "required_numerical_contracts": {
    "decoder.attention_gate": {
      "op": "attn_gate_softplus_mul",
      "operation_interface": "attn_gate_softplus_mul.fp32.v1",
      "template_ops": ["attn_gate_softplus_mul"],
      "phases": {
        "prefill": {"contract_id": "attention_gate_softplus_head_scalar_fp32_output", "validation": "observed", "evidence": "Real Laguna artifact shape and isolated softplus broadcast test."},
        "decode": {"contract_id": "attention_gate_softplus_head_scalar_fp32_output", "validation": "observed", "evidence": "Real Laguna artifact shape and isolated softplus broadcast test."}
      },
      "checkpoint": {"id": "decoder.layer.{layer}.attention_gate.output", "producer": "attn_gate_softplus_mul", "logical_layout": "token_head_channel", "axis_names": ["token", "head", "channel"]}
    }
  },
  "sequence": ["decoder"],
  "block_types": {
    "decoder": {
      "sequence": ["header", "body", "footer"],
      "header": ["bpe_tokenizer", "dense_embedding_lookup"],
      "body": {
        "type": "hybrid_attention_moe",
        "kind_config_key": "layer_kinds",
        "default_kind": "moe_sliding_attention",
        "ops_by_kind": {
          "dense_global_attention": [
            "rmsnorm", "q_proj", "k_proj", "v_proj", "qk_norm", "rope_qk",
            "attention_gate_projection", "attn", "attn_gate_softplus_mul", "out_proj",
            "residual_add", "rmsnorm", "mlp_gate_up", "silu_mul", "mlp_down", "residual_add"
          ],
          "moe_global_attention": [
            "rmsnorm", "q_proj", "k_proj", "v_proj", "qk_norm", "rope_qk",
            "attention_gate_projection", "attn", "attn_gate_softplus_mul", "out_proj",
            "residual_add",
            {"op": "ffn_norm", "graph_slots": {"inputs": {"input": "main_stream"}, "outputs": {"output": "normalized_stream"}}},
            {"op": "moe_router", "graph_slots": {"inputs": {"A": "normalized_stream"}, "outputs": {"C": "mlp_scratch"}}},
            "group_limited_topk_router",
            {"op": "moe_swiglu_expert_mlp", "graph_slots": {"inputs": {"hidden": "normalized_stream", "indices": "q_scratch", "routing_weights": "k_scratch"}, "outputs": {"output": "mlp_scratch"}}},
            {"op": "shared_swiglu_expert_mlp", "graph_slots": {"inputs": {"hidden": "normalized_stream", "routed": "mlp_scratch"}, "outputs": {"output": "main_stream"}}},
            "residual_add"
          ],
          "moe_sliding_attention": [
            "rmsnorm", "q_proj", "k_proj", "v_proj", "qk_norm",
            {"op": "rope_qk", "kernel": "rope_forward_qk_split_direct"},
            "attention_gate_projection", "attn_sliding", "attn_gate_softplus_mul", "out_proj",
            "residual_add",
            {"op": "ffn_norm", "graph_slots": {"inputs": {"input": "main_stream"}, "outputs": {"output": "normalized_stream"}}},
            {"op": "moe_router", "graph_slots": {"inputs": {"A": "normalized_stream"}, "outputs": {"C": "mlp_scratch"}}},
            "group_limited_topk_router",
            {"op": "moe_swiglu_expert_mlp", "graph_slots": {"inputs": {"hidden": "normalized_stream", "indices": "q_scratch", "routing_weights": "k_scratch"}, "outputs": {"output": "mlp_scratch"}}},
            {"op": "shared_swiglu_expert_mlp", "graph_slots": {"inputs": {"hidden": "normalized_stream", "routed": "mlp_scratch"}, "outputs": {"output": "main_stream"}}},
            "residual_add"
          ]
        }
      },
      "footer": ["final_rmsnorm", "lm_head", "logits"]
    }
  }
}
