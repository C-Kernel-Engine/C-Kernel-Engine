#!/bin/bash
# =============================================================================
# CK-Engine Pre-Push Hook
# =============================================================================
# Runs essential tests before allowing push to remote.
# This catches issues that CI might miss due to resource constraints.
#
# Install: git config core.hooksPath .githooks
# Or:      ln -sf ../../.githooks/pre-push .git/hooks/pre-push
# =============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT_DIR" ]; then
    ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi
HOME_DIR="${HOME:-$ROOT_DIR}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo ""
echo -e "${YELLOW}╔════════════════════════════════════════════════════════════╗${NC}"
echo -e "${YELLOW}║           CK-Engine Pre-Push Validation                    ║${NC}"
echo -e "${YELLOW}╚════════════════════════════════════════════════════════════╝${NC}"
echo ""

# Allow skipping with --no-verify or CK_SKIP_PREPUSH=1
if [ -n "$CK_SKIP_PREPUSH" ]; then
    echo -e "${YELLOW}⚠️  Skipping pre-push tests (CK_SKIP_PREPUSH=1)${NC}"
    exit 0
fi

cd "$ROOT_DIR"

echo -e "${YELLOW}Checking repository source integrity...${NC}"
if ! python3 scripts/check_source_integrity.py; then
    echo -e "${RED}✗ Resolve every merge marker and unmerged index entry before pushing${NC}" >&2
    exit 1
fi

PREPUSH_LOCK_PATH="${CK_PREPUSH_LOCK_PATH:-${HOME_DIR}/.cache/ck-engine/model-regression.lock}"
PREPUSH_MIN_AVAILABLE_GB="${CK_PREPUSH_MIN_AVAILABLE_GB:-16}"
PREPUSH_MIN_SWAP_FREE_GB="${CK_PREPUSH_MIN_SWAP_FREE_GB:-2}"
PREPUSH_THREADS="${CK_PREPUSH_THREADS:-8}"
PREPUSH_BUILD_JOBS="${CK_PREPUSH_BUILD_JOBS:-8}"
PREPUSH_TIMEOUT_SECONDS="${CK_PREPUSH_TIMEOUT_SECONDS:-1800}"

require_nonnegative_integer() {
    local name="$1"
    local value="$2"
    if ! [[ "$value" =~ ^[0-9]+$ ]]; then
        echo -e "${RED}✗ ${name} must be a non-negative integer; got ${value}${NC}" >&2
        exit 2
    fi
}

require_nonnegative_integer CK_PREPUSH_MIN_AVAILABLE_GB "$PREPUSH_MIN_AVAILABLE_GB"
require_nonnegative_integer CK_PREPUSH_MIN_SWAP_FREE_GB "$PREPUSH_MIN_SWAP_FREE_GB"
require_nonnegative_integer CK_PREPUSH_THREADS "$PREPUSH_THREADS"
require_nonnegative_integer CK_PREPUSH_BUILD_JOBS "$PREPUSH_BUILD_JOBS"
require_nonnegative_integer CK_PREPUSH_TIMEOUT_SECONDS "$PREPUSH_TIMEOUT_SECONDS"
if [ "$PREPUSH_THREADS" -eq 0 ] || [ "$PREPUSH_BUILD_JOBS" -eq 0 ] \
    || [ "$PREPUSH_TIMEOUT_SECONDS" -eq 0 ]; then
    echo -e "${RED}✗ CK_PREPUSH_THREADS, CK_PREPUSH_BUILD_JOBS, and CK_PREPUSH_TIMEOUT_SECONDS must be positive${NC}" >&2
    exit 2
fi

mkdir -p "$(dirname "$PREPUSH_LOCK_PATH")"
exec 9>"$PREPUSH_LOCK_PATH"
if ! flock -n 9; then
    echo -e "${RED}✗ Another CK-Engine commit/push model regression is already running${NC}" >&2
    echo "  Lock: $PREPUSH_LOCK_PATH" >&2
    echo "  Wait for that run to finish; do not start overlapping model regressions." >&2
    exit 2
fi

check_resource_headroom() {
    local available_kb
    local swap_total_kb
    local swap_free_kb
    local min_available_kb=$((PREPUSH_MIN_AVAILABLE_GB * 1024 * 1024))
    local min_swap_free_kb=$((PREPUSH_MIN_SWAP_FREE_GB * 1024 * 1024))
    available_kb="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)"
    swap_total_kb="$(awk '/^SwapTotal:/ {print $2}' /proc/meminfo)"
    swap_free_kb="$(awk '/^SwapFree:/ {print $2}' /proc/meminfo)"
    if [ -n "${CK_PREPUSH_ALLOW_LOW_RESOURCES:-}" ]; then
        return 0
    fi
    if [ -z "$available_kb" ] || [ "$available_kb" -lt "$min_available_kb" ]; then
        echo -e "${RED}✗ Insufficient memory headroom for pre-push model validation${NC}" >&2
        echo "  Required: ${PREPUSH_MIN_AVAILABLE_GB} GiB MemAvailable" >&2
        echo "  Observed: $(( ${available_kb:-0} / 1024 / 1024 )) GiB" >&2
        echo "  Finish other model jobs or set CK_PREPUSH_ALLOW_LOW_RESOURCES=1 explicitly." >&2
        exit 2
    fi
    if [ "${swap_total_kb:-0}" -gt 0 ] \
        && { [ -z "$swap_free_kb" ] || [ "$swap_free_kb" -lt "$min_swap_free_kb" ]; }; then
        echo -e "${RED}✗ Insufficient free swap headroom for pre-push model validation${NC}" >&2
        echo "  Required: ${PREPUSH_MIN_SWAP_FREE_GB} GiB SwapFree" >&2
        echo "  Observed: $(( ${swap_free_kb:-0} / 1024 / 1024 )) GiB" >&2
        echo "  Finish other model jobs or set CK_PREPUSH_ALLOW_LOW_RESOURCES=1 explicitly." >&2
        exit 2
    fi
}

run_prepush_make() {
    local log_path="$1"
    shift
    timeout --signal=TERM --kill-after=30s "$PREPUSH_TIMEOUT_SECONDS" \
        make "$@" >"$log_path" 2>&1
}

check_resource_headroom
export CK_NUM_THREADS="${CK_NUM_THREADS:-$PREPUSH_THREADS}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
renice 10 -p $$ >/dev/null 2>&1 || true
ionice -c 2 -n 7 -p $$ >/dev/null 2>&1 || true
echo -e "${YELLOW}  ↳ resource floor: ${PREPUSH_MIN_AVAILABLE_GB} GiB available RAM, ${PREPUSH_MIN_SWAP_FREE_GB} GiB free swap${NC}"
echo -e "${YELLOW}  ↳ execution: ${CK_NUM_THREADS} CK threads, OMP=${OMP_NUM_THREADS}, build jobs=${PREPUSH_BUILD_JOBS}, timeout=${PREPUSH_TIMEOUT_SECONDS}s${NC}"

# Ignored Python environments are normally present only in the primary
# checkout. Clean worktrees must run the same gates, so borrow a validated
# environment for this hook invocation and remove the link on exit.
PREPUSH_ENV_LINK_CREATED=0
python_env_root="${CK_PREPUSH_PYTHON_ENV_ROOT:-}"
if [ -z "$python_env_root" ] || [ ! -x "$python_env_root/.venv/bin/python" ]; then
    while IFS= read -r worktree_path; do
        if [ -x "$worktree_path/.venv/bin/python" ]; then
            python_env_root="$worktree_path"
            break
        fi
    done < <(git worktree list --porcelain | sed -n 's/^worktree //p')
fi
if [ ! -e "$ROOT_DIR/.venv" ] && [ -x "$python_env_root/.venv/bin/python" ]; then
    ln -s "$python_env_root/.venv" "$ROOT_DIR/.venv"
    PREPUSH_ENV_LINK_CREATED=1
fi

llama_cpp_root="${CK_LLAMA_CPP_ROOT:-${LLAMA_CPP_ROOT:-$ROOT_DIR/llama.cpp}}"
if [ -z "$llama_cpp_root" ] || [ ! -f "$llama_cpp_root/build/bin/libllama.so" ]; then
    while IFS= read -r worktree_path; do
        if [ -f "$worktree_path/llama.cpp/build/bin/libllama.so" ]; then
            llama_cpp_root="$worktree_path/llama.cpp"
            break
        fi
    done < <(git worktree list --porcelain | sed -n 's/^worktree //p')
fi
if [ -f "$llama_cpp_root/build/bin/libllama.so" ]; then
    export CK_LLAMA_CPP_ROOT="$llama_cpp_root"
fi

cleanup_prepush_environment() {
    if [ "$PREPUSH_ENV_LINK_CREATED" = "1" ]; then
        rm -f "$ROOT_DIR/.venv"
    fi
    if [ -n "${CHANGE_METADATA_LOG:-}" ]; then
        rm -f "$CHANGE_METADATA_LOG"
    fi
}
trap cleanup_prepush_environment EXIT

PREPUSH_ROOT="${CK_PREPUSH_ROOT:-${HOME:-$ROOT_DIR}/.cache/ck-engine/prepush}"
PREPUSH_REGRESSION_ROOT="${PREPUSH_ROOT}/regression"
PREPUSH_TRAIN_REPORT_ROOT="${PREPUSH_ROOT}/training-reports"
mkdir -p "$PREPUSH_REGRESSION_ROOT" "$PREPUSH_TRAIN_REPORT_ROOT"

failed=0
declare -A CK_PUSH_SHA_SEEN=()
declare -A CK_PUSH_FILE_SEEN=()
ZERO_SHA="0000000000000000000000000000000000000000"
PUSH_TARGETS=()
PUSH_REMOTE_SHAS=()
PUSH_CHANGED_FILES=()
PUSH_RECORDS_SEEN=0
PUSH_DELETIONS_SEEN=0
while read -r local_ref local_sha remote_ref remote_sha; do
    PUSH_RECORDS_SEEN=$((PUSH_RECORDS_SEEN + 1))
    if [ -z "${local_sha:-}" ] || [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        PUSH_DELETIONS_SEEN=$((PUSH_DELETIONS_SEEN + 1))
        continue
    fi
    if [ -n "${CK_PUSH_SHA_SEEN[$local_sha]:-}" ]; then
        continue
    fi
    CK_PUSH_SHA_SEEN[$local_sha]=1
    PUSH_TARGETS+=("$local_sha")
    PUSH_REMOTE_SHAS+=("${remote_sha:-$ZERO_SHA}")
done
if [ ${#PUSH_TARGETS[@]} -eq 0 ]; then
    if [ "$PUSH_RECORDS_SEEN" -gt 0 ] && [ "$PUSH_RECORDS_SEEN" -eq "$PUSH_DELETIONS_SEEN" ]; then
        echo -e "${GREEN}  ✓ Deletion-only push; no new commits require validation${NC}"
        exit 0
    fi
    # Direct/manual hook invocation has no ref records; retain the historical
    # behavior of validating the checked-out tip.
    PUSH_TARGETS=("HEAD")
    PUSH_REMOTE_SHAS=("$ZERO_SHA")
fi

_record_push_changed_file() {
    local path="${1:-}"
    if [ -z "$path" ] || [ -n "${CK_PUSH_FILE_SEEN[$path]:-}" ]; then
        return 0
    fi
    CK_PUSH_FILE_SEEN[$path]=1
    PUSH_CHANGED_FILES+=("$path")
}

for idx in "${!PUSH_TARGETS[@]}"; do
    local_sha="${PUSH_TARGETS[$idx]}"
    remote_sha="${PUSH_REMOTE_SHAS[$idx]:-$ZERO_SHA}"
    if [ "$remote_sha" != "$ZERO_SHA" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        while IFS= read -r path; do
            _record_push_changed_file "$path"
        done < <(git diff --name-only "$remote_sha" "$local_sha" --)
    else
        while IFS= read -r path; do
            _record_push_changed_file "$path"
        done < <(git diff-tree --root --no-commit-id --name-only -r "$local_sha" --)
    fi
done

ck_should_run_v7_regression_fast=0
ck_should_run_v8_regression_fast=0
case "${CK_PREPUSH_REGRESSION_FAST:-auto}" in
    1|true|TRUE|yes|YES|always)
        ck_should_run_v7_regression_fast=1
        ck_should_run_v8_regression_fast=1
        ;;
    0|false|FALSE|no|NO|never)
        ck_should_run_v7_regression_fast=0
        ck_should_run_v8_regression_fast=0
        ;;
    *)
        for path in "${PUSH_CHANGED_FILES[@]}"; do
            case "$path" in
                Makefile|.githooks/pre-commit|.githooks/pre-push|.github/workflows/nightly.yml)
                    ck_should_run_v7_regression_fast=1
                    ck_should_run_v8_regression_fast=1
                    ;;
                scripts/*|src/*|tests/*)
                    ck_should_run_v7_regression_fast=1
                    ck_should_run_v8_regression_fast=1
                    ;;
                version/v7/scripts/*|version/v7/templates/*|version/v7/regression/*|version/v7/test_assets/*|version/v7/src/*|version/v7/kernel_maps/*|version/v7/README.md)
                    ck_should_run_v7_regression_fast=1
                    ;;
                version/v8/scripts/*|version/v8/circuits/*|version/v8/contracts/*|version/v8/schemas/*|version/v8/regression/*|version/v8/test_assets/*|version/v8/src/*|version/v8/kernel_maps/*|version/v8/README.md)
                    ck_should_run_v8_regression_fast=1
                    ;;
            esac
            if [ "$ck_should_run_v7_regression_fast" = "1" ] && [ "$ck_should_run_v8_regression_fast" = "1" ]; then
                break
            fi
        done
        ;;
esac

if [ "$ck_should_run_v7_regression_fast" = "1" ]; then
    echo -e "${YELLOW}  ↳ v7-regression-fast enabled for pushed shared/v7 runtime changes${NC}"
else
    echo -e "${YELLOW}  ↳ v7-regression-fast skipped${NC}"
fi

if [ "$ck_should_run_v8_regression_fast" = "1" ]; then
    echo -e "${YELLOW}  ↳ v8-regression-fast enabled for pushed shared/v8 runtime changes${NC}"
else
    echo -e "${YELLOW}  ↳ v8-regression-fast skipped${NC}"
fi

echo -e "${YELLOW}  ↳ v6.6 is archive/manual only (run make v6.6-gate explicitly if needed)${NC}"

# =============================================================================
# Test 0: Submodule pin sanity (prevents CI checkout breakage)
# =============================================================================
echo -e "${YELLOW}[0/6]${NC} Validating submodule pins..."
printf '' > /tmp/ck_submodule_pins.log
submodule_pin_ok=1
for push_target in "${PUSH_TARGETS[@]}"; do
    if ! python3 scripts/validate_submodule_pins.py --treeish "$push_target" >> /tmp/ck_submodule_pins.log 2>&1; then
        submodule_pin_ok=0
        break
    fi
done
if [ "$submodule_pin_ok" = "1" ]; then
    echo -e "${GREEN}  ✓ Submodule pins reachable on configured remotes${NC}"
else
    echo -e "${RED}  ✗ Submodule pin validation failed${NC}"
    tail -20 /tmp/ck_submodule_pins.log
    exit 1
fi

# =============================================================================
# Test 0.5: Visualizer health (fast static analysis, no build needed)
# =============================================================================
echo -e "${YELLOW}[0.5/6]${NC} Visualizer HTML/JS health check..."
if python3 version/v7/scripts/test_visualizer_health_v7.py --source --quiet > /tmp/ck_visualizer_health.log 2>&1 \
   && python3 version/v7/scripts/test_visualizer_js_units_v7.py --quiet >> /tmp/ck_visualizer_health.log 2>&1; then
    echo -e "${GREEN}  ✓ Visualizer health passed${NC}"
else
    echo -e "${RED}  ✗ Visualizer health failed (tabs/functions/contracts)${NC}"
    tail -20 /tmp/ck_visualizer_health.log
    failed=1
fi

# =============================================================================
# Test 0.6: Change metadata (same rules as the Change Metadata CI gate)
# =============================================================================
echo -e "${YELLOW}[0.6/6]${NC} Validating commit change metadata..."
metadata_ok=1
CHANGE_METADATA_LOG="$(mktemp "${TMPDIR:-/tmp}/ck_change_metadata.XXXXXX")"
for idx in "${!PUSH_TARGETS[@]}"; do
    push_target="${PUSH_TARGETS[$idx]}"
    remote_sha="${PUSH_REMOTE_SHAS[$idx]:-$ZERO_SHA}"
    range_base=""
    if [ "$remote_sha" != "$ZERO_SHA" ]; then
        range_base="$remote_sha"
    else
        # New branch: validate commits not yet on the remote default branch.
        range_base=$(git merge-base origin/HEAD "$push_target" 2>/dev/null || true)
    fi
    if [ -n "$range_base" ] && [ "$range_base" != "$push_target" ]; then
        python3 scripts/validate_change_metadata.py commits --base "$range_base" --head "$push_target" >> "$CHANGE_METADATA_LOG" 2>&1 || metadata_ok=0
    else
        # No usable range (e.g. offline clone): validate the tip commit only.
        python3 scripts/validate_change_metadata.py commit --message "$(git show -s --format=%B "$push_target")" >> "$CHANGE_METADATA_LOG" 2>&1 || metadata_ok=0
    fi
done
if [ "$metadata_ok" = "1" ]; then
    echo -e "${GREEN}  ✓ Commit change metadata passed${NC}"
else
    echo -e "${RED}  ✗ Commit change metadata failed (Why/What/Validation/Evidence/Docs/Nightly/Content)${NC}"
    tail -20 "$CHANGE_METADATA_LOG"
    failed=1
fi

# Toolchain policy:
# - Use the parity-certified GCC path by default, even when oneAPI is installed.
# - Exercise ICX only when CK_PREPUSH_USE_INTEL=1 is explicitly requested.
INTEL_SETVARS="${CK_PREPUSH_INTEL_SETVARS:-/opt/intel/oneapi/setvars.sh}"
if [ -z "${CK_PREPUSH_USE_INTEL:-}" ]; then
    CK_PREPUSH_USE_INTEL=0
fi

if [ "${CK_PREPUSH_USE_INTEL}" = "1" ]; then
    if [ -f "$INTEL_SETVARS" ]; then
        # shellcheck disable=SC1090
        source "$INTEL_SETVARS" >/tmp/ck_prepush_setvars.log 2>&1 || true
    fi
    # Harden runtime linker path for Python/ctypes loaders that need Intel libs.
    # setvars.sh can be a no-op if already sourced; always prepend known compiler paths.
    INTEL_COMPILER_LIB="/opt/intel/oneapi/compiler/latest/lib"
    INTEL_COMPILER_OPT_LIB="/opt/intel/oneapi/compiler/latest/opt/compiler/lib"
    if [ -d "$INTEL_COMPILER_LIB" ]; then
        export LD_LIBRARY_PATH="$INTEL_COMPILER_LIB:$INTEL_COMPILER_OPT_LIB:${LD_LIBRARY_PATH:-}"
    fi
    export CC="${CK_PREPUSH_CC:-icx}"
    export CXX="${CK_PREPUSH_CXX:-icpx}"
    export CK_V6_COMPILER="${CK_V6_COMPILER:-icx}"
    export CK_V7_COMPILER="${CK_V7_COMPILER:-icx}"
    export CK_V8_COMPILER="${CK_V8_COMPILER:-icx}"
    echo -e "${YELLOW}  ↳ Toolchain: CC=${CC} CXX=${CXX} (Intel mode)${NC}"
else
    export CC="${CK_PREPUSH_CC:-gcc}"
    export CXX="${CK_PREPUSH_CXX:-g++}"
    export CK_V6_COMPILER="${CK_V6_COMPILER:-gcc}"
    export CK_V7_COMPILER="${CK_V7_COMPILER:-gcc}"
    export CK_V8_COMPILER="${CK_V8_COMPILER:-gcc}"
    export USE_NATIVE=1
    unset USE_MKL
    unset USE_ONEDNN
    echo -e "${YELLOW}  ↳ Toolchain: CC=${CC} CXX=${CXX} (portable mode)${NC}"
    echo -e "${YELLOW}    set CK_PREPUSH_USE_INTEL=1 to keep Intel compiler/runtime path${NC}"
fi

# =============================================================================
# Test 1: Compilation
# =============================================================================
echo -e "${YELLOW}[1/6]${NC} Building CK-Engine..."
if run_prepush_make /tmp/ck_build.log -j"$PREPUSH_BUILD_JOBS"; then
    echo -e "${GREEN}  ✓ Build successful${NC}"
else
    echo -e "${RED}  ✗ Build failed${NC}"
    echo "    See /tmp/ck_build.log for details"
    failed=1
fi

# =============================================================================
# Test 2: Quick kernel tests (if parity lib exists)
# =============================================================================
echo -e "${YELLOW}[2/6]${NC} Running kernel parity tests..."
if [ -f "build/libck_parity.so" ] || [ -f "libck_parity.so" ]; then
    # Ensure llama.cpp kernel test library exists (auto-build if missing)
    if [ ! -f "llama.cpp/libggml_kernel_test.so" ]; then
        echo -e "${YELLOW}  ↳ Building llama.cpp kernel test library...${NC}"
        if [ -d "llama.cpp" ]; then
            (cd llama.cpp && make -j$(nproc) > /tmp/ck_llama_build.log 2>&1) || true
            (cd llama.cpp && g++ -shared -fPIC -o libggml_kernel_test.so \
                tests/test-kernel-parity.cpp \
                -I ggml/include -I ggml/src \
                -L build -lggml -lm -lpthread > /tmp/ck_llama_kernel_test.log 2>&1) || true
        fi
    fi

    if python3 scripts/test_kernels_vs_llamacpp.py --quick > /tmp/ck_parity.log 2>&1; then
        echo -e "${GREEN}  ✓ Kernel parity tests passed${NC}"
    else
        # If Intel runtime or llama test lib missing, mark as skipped instead of fail
        if grep -qiE "libimf.so|libggml_kernel_test.so|Could not load llama.cpp kernel test library" /tmp/ck_parity.log; then
            echo -e "${YELLOW}  ⚠ Skipped (missing runtime or llama.cpp test lib)${NC}"
        else
            echo -e "${RED}  ✗ Kernel parity tests failed${NC}"
            echo "    See /tmp/ck_parity.log for details"
            failed=1
        fi
    fi
else
    echo -e "${YELLOW}  ⚠ Skipped (no parity library - build with: make libck_parity.so)${NC}"
fi

# =============================================================================
# Test 3: v8 runner E2E text smoke
# =============================================================================
echo -e "${YELLOW}[3/6]${NC} Running v8 E2E text smoke..."

# Candidate models for v8 E2E smoke:
# 1) explicit override, 2) local cache, 3) HF GGUF URL fallback.
MODEL_CANDIDATES=()
if [ -n "${CK_E2E_MODEL:-}" ]; then
  MODEL_CANDIDATES+=("${CK_E2E_MODEL}")
fi

LOCAL_CACHE_ROOTS=(
  "$HOME/.cache/ck-engine-v8/models"
  "$HOME/.cache/ck-engine-v7/models"
)
LOCAL_REPOS=(
  "unsloth--gemma-3-270m-it-GGUF"
  "Qwen--Qwen3-0.6B-GGUF"
  "Qwen--Qwen2-0.5B-Instruct-GGUF"
)
for cache_root in "${LOCAL_CACHE_ROOTS[@]}"; do
  for repo in "${LOCAL_REPOS[@]}"; do
    C="${cache_root}/${repo}"
    if [ -d "$C" ]; then
      GGUF_LOCAL=$(find "$C" -maxdepth 1 -type f -name "*.gguf" 2>/dev/null | sort | head -1 || true)
      if [ -n "$GGUF_LOCAL" ] && [ -f "$GGUF_LOCAL" ]; then
        MODEL_CANDIDATES+=("$GGUF_LOCAL")
      elif [ -f "$C/config.json" ]; then
        MODEL_CANDIDATES+=("$C")
      fi
    fi
  done
done

HF_CANDIDATES=(
  "hf://unsloth/gemma-3-270m-it-GGUF/gemma-3-270m-it-Q5_K_M.gguf"
  "hf://Qwen/Qwen3-0.6B-GGUF/Qwen3-0.6B-Q8_0.gguf"
  "hf://Qwen/Qwen2-0.5B-Instruct-GGUF/qwen2-0_5b-instruct-q4_k_m.gguf"
)
for C in "${HF_CANDIDATES[@]}"; do
  MODEL_CANDIDATES+=("$C")
done

PROMPTS=(
  "Hello! Reply with a single short sentence."
  "Give a tiny C function that returns 42."
)

RUNNER=()
if [ -x "$ROOT_DIR/.venv/bin/python" ] && [ -f "version/v8/scripts/ck_run_v8.py" ]; then
    RUNNER=("$ROOT_DIR/.venv/bin/python" "version/v8/scripts/ck_run_v8.py")
elif command -v python3 >/dev/null 2>&1 && [ -f "version/v8/scripts/ck_run_v8.py" ]; then
    RUNNER=("python3" "version/v8/scripts/ck_run_v8.py")
elif [ -x "version/v8/scripts/cks-v8-run" ]; then
    RUNNER=("version/v8/scripts/cks-v8-run")
fi

E2E_CACHE_DIR="${CK_E2E_CACHE_DIR:-$HOME/.cache/ck-engine-v8/models}"
E2E_TIMEOUT_SEC="${CK_E2E_TIMEOUT_SEC:-240}"
mkdir -p "$E2E_CACHE_DIR"

if [ ${#RUNNER[@]} -ne 0 ]; then
    check_resource_headroom
    e2e_ok=0
    e2e_network_skip=0
    e2e_permission_skip=0
    for MODEL in "${MODEL_CANDIDATES[@]}"; do
        candidate_status="ok"
        echo -e "${YELLOW}  ↳ E2E model: ${MODEL}${NC}"
        echo -e "${YELLOW}    Prompts:${NC}"
        for P in "${PROMPTS[@]}"; do
            echo -e "${YELLOW}    - ${P}${NC}"
        done

        for P in "${PROMPTS[@]}"; do
            RUN_ARGS=(
              run "$MODEL"
              --prompt "$P"
              --max-tokens 5
              --context-len 128
              --chat-template auto
            )
            # Keep pre-push E2E portable and non-destructive by default.
            if [ "${CK_E2E_FORCE_COMPILE:-0}" = "1" ]; then
                RUN_ARGS+=(--force-convert --force-compile)
            fi
            set +e
            OUTPUT=$(CK_CACHE_DIR="$E2E_CACHE_DIR" timeout "$E2E_TIMEOUT_SEC" "${RUNNER[@]}" "${RUN_ARGS[@]}" 2>&1)
            run_status=$?
            set -e

            if [ "$run_status" -eq 124 ]; then
                if [[ "$MODEL" == hf://* ]]; then
                    echo -e "${YELLOW}  ⚠ Skipped candidate (timeout while preparing remote model): ${MODEL}${NC}"
                    candidate_status="network_skip"
                    e2e_network_skip=1
                    break
                fi
                echo -e "${RED}  ✗ E2E inference timed out${NC}"
                echo "$OUTPUT" | tail -5
                failed=1
                candidate_status="hard_fail"
                break
            fi

            if echo "$OUTPUT" | grep -qiE "Temporary failure in name resolution|Connection timed out|Could not resolve host|No route to host|network is unreachable|HTTPError|httpx|client has been closed"; then
                echo -e "${YELLOW}  ⚠ Skipped candidate (network unavailable): ${MODEL}${NC}"
                candidate_status="network_skip"
                e2e_network_skip=1
                break
            fi
            if echo "$OUTPUT" | grep -qiE "Permission denied|Errno 13"; then
                echo -e "${YELLOW}  ⚠ Skipped candidate (cache permission issue): ${MODEL}${NC}"
                candidate_status="permission_skip"
                e2e_permission_skip=1
                break
            fi
            if echo "$OUTPUT" | grep -qiE "Missing attention.head_count|GGUFError"; then
                echo -e "${YELLOW}  ⚠ Skipped candidate (GGUF metadata missing): ${MODEL}${NC}"
                candidate_status="incompatible"
                break
            fi
            if echo "$OUTPUT" | grep -qiE "segfault|SIGSEGV|Traceback|assertion failed|abort"; then
                echo -e "${RED}  ✗ E2E inference crashed${NC}"
                echo "$OUTPUT" | tail -5
                failed=1
                candidate_status="hard_fail"
                break
            elif echo "$OUTPUT" | grep -qiE "mmap failed|Cannot allocate memory|out of memory|ENOMEM"; then
                echo -e "${RED}  ✗ E2E inference failed (insufficient memory)${NC}"
                echo "$OUTPUT" | tail -3
                failed=1
                candidate_status="hard_fail"
                break
            elif echo "$OUTPUT" | grep -qE "tok/s|Response:|Generated|Assistant:"; then
                e2e_ok=1
            else
                echo -e "${YELLOW}  ⚠ E2E inference unclear (check output)${NC}"
                echo "$OUTPUT" | tail -3
                candidate_status="hard_fail"
                break
            fi

            # Basic perf warning (non-fatal)
            if command -v rg >/dev/null 2>&1; then
                tok_s=$(echo "$OUTPUT" | rg -o "([0-9]+\\.?[0-9]*)\\s*tok/s" | head -1 | rg -o "[0-9]+\\.?[0-9]*" || true)
            else
                tok_s=$(echo "$OUTPUT" | grep -oE "([0-9]+\\.?[0-9]*)[[:space:]]*tok/s" | head -1 | grep -oE "[0-9]+\\.?[0-9]*" || true)
            fi
            if [ -n "$tok_s" ]; then
                warn=$(python3 - <<PY
tok = float("$tok_s")
print("1" if tok < 2.0 else "0")
PY
)
                if [ "$warn" = "1" ]; then
                    echo -e "${YELLOW}  ⚠ Low throughput: ${tok_s} tok/s${NC}"
                fi
            fi
        done

        if [ "$failed" -ne 0 ]; then
            break
        fi
        if [ "$candidate_status" = "ok" ] && [ "$e2e_ok" -eq 1 ]; then
            break
        fi
    done

    if [ "$failed" -ne 0 ]; then
        :
    elif [ "$e2e_ok" -eq 1 ]; then
        echo -e "${GREEN}  ✓ E2E inference passed${NC}"
    elif [ "$e2e_permission_skip" -ne 0 ]; then
        echo -e "${YELLOW}  ⚠ E2E inference skipped (cache permission issue and no candidate passed)${NC}"
    elif [ "$e2e_network_skip" -ne 0 ]; then
        echo -e "${YELLOW}  ⚠ E2E inference skipped (network unavailable and no local candidate passed)${NC}"
    elif [ "$e2e_ok" -eq 0 ]; then
        echo -e "${RED}  ✗ E2E inference failed (no usable candidate)${NC}"
        failed=1
    fi
else
    echo -e "${YELLOW}  ⚠ Skipped (no runner script found)${NC}"
fi

