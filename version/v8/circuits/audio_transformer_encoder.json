{
  "version": 5,
  "name": "audio_transformer_encoder",
  "family": "audio_transformer",
  "flags": {
    "activation": "gelu",
    "normalization": "layernorm",
    "feature_layout": "channel_major",
    "encoder_layout": "token_major"
  },
  "contract": {
    "audio_frontend": {
      "input_modality": "wav_bytes",
      "container": "riff_wave",
      "sample_encoding": "pcm_s16_le",
      "channel_layout": "mono_mean",
      "sample_rate": 16000,
      "sample_extent": 480000,
      "windowing": "fixed_non_overlapping_source_windows",
      "window_offset_unit": "source_frame",
      "long_audio_resample": "require_identity_until_global_phase_is_validated",
      "long_audio_feature_window": "global_stft_logmel_then_slice_and_zero_pad",
      "resample": "hann_windowed_sinc",
      "resample_radius": 16,
      "n_fft": 400,
      "hop_length": 160,
      "centering": "reflect",
      "window": "periodic_hann",
      "mel_scale": "slaney",
      "output": "normalized_log_mel"
    },
    "audio_encoder": {
      "input_modality": "audio_features",
      "stem": "two_stage_conv1d",
      "position_encoding": "absolute",
      "attention": "dense_bidirectional",
      "output": "audio_encoder_embeddings",
      "runtime_topology_policy": {
        "config_key": "audio_runtime_topology_policy",
        "supported": [
          "all_allowed_cpus",
          "performance_core_smt_on_hybrid"
        ],
        "fallback": "all_allowed_cpus"
      }
    },
    "block_contract": {
      "norm_type": "layernorm",
      "activation": "gelu",
      "attention_causal": false,
      "mlp_formula": "up -> gelu -> down"
    },
    "attention_contract": {
      "causal": false,
      "attn_variant": "dense_bidirectional",
      "kv_layout": "ephemeral_full_context",
      "rope_layout": "none"
    }
  },
  "required_numerical_contracts": {
    "audio.frontend.wav_decode": {
      "op": "audio_wav_decode",
      "template_ops": ["audio_wav_decode"],
      "phases": {
        "prefill": {
          "contract_id": "audio_wav_pcm16_parse_channel_mean_fp32",
          "validation": "validated",
          "evidence": "unittest/test_audio_encoder.py RIFF bounds, PCM16 mono, and channel-mean oracle"
        }
      },
      "checkpoint": {
        "id": "audio.frontend.decode.output",
        "producer": "audio_wav_decode",
        "logical_layout": "sample_major",
        "axis_names": ["sample"]
      }
    },
    "audio.frontend.resample": {
      "op": "audio_resample",
      "template_ops": ["audio_resample"],
      "phases": {
        "prefill": {
          "contract_id": "audio_resample_windowed_sinc_fp64_accum_fp32_output",
          "validation": "validated",
          "evidence": "unittest/test_audio_encoder.py band-limited resampling oracle"
        }
      },
      "checkpoint": {
        "id": "audio.frontend.resample.output",
        "producer": "audio_resample",
        "logical_layout": "sample_major",
        "axis_names": ["sample"]
      }
    },
    "audio.frontend.pad": {
      "op": "audio_pad_or_truncate",
      "template_ops": ["audio_pad_or_truncate"],
      "phases": {
        "prefill": {
          "contract_id": "audio_pad_or_truncate_prefix_zero_fp32",
          "validation": "validated",
          "evidence": "unittest/test_audio_encoder.py exact prefix, truncation, and zero-tail matrix"
        }
      },
      "checkpoint": {
        "id": "audio.frontend.samples.output",
        "producer": "audio_pad_or_truncate",
        "logical_layout": "sample_major",
        "axis_names": ["sample"]
      }
    },
    "audio.frontend.stft_tables": {
      "op": "audio_stft_tables",
      "template_ops": ["audio_stft_tables"],
      "phases": {
        "prefill": {
          "contract_id": "audio_stft_periodic_hann_tables_fp32",
          "validation": "validated",
          "evidence": "unittest/test_audio_encoder.py periodic-Hann and trigonometric-table identities"
        }
      },
      "checkpoint": {
        "id": "audio.frontend.stft_tables.output",
        "producer": "audio_stft_tables",
        "logical_layout": "frequency_sample",
        "axis_names": ["frequency", "sample"]
      }
    },
    "audio.frontend.stft": {
      "op": "audio_stft",
      "template_ops": ["audio_stft"],
      "phases": {
        "prefill": {
          "contract_id": "audio_stft_centered_hann_fft400_radix20_fp32",
          "validation": "validated",
          "evidence": "unittest/test_audio_encoder.py optimized FFT400 power oracle"
        }
      },
      "checkpoint": {
        "id": "audio.frontend.stft.output",
        "producer": "audio_stft",
        "logical_layout": "frame_major",
        "axis_names": ["frame", "frequency"]
      }
    },
    "audio.frontend.mel_filters": {
      "op": "audio_mel_filters",
      "template_ops": ["audio_mel_filters"],
      "phases": {
        "prefill": {
          "contract_id": "audio_whisper_mel_filters_slaney_fp32",
          "validation": "validated",
          "evidence": "unittest/test_audio.py fixed Whisper Slaney filter identity"
        }
      },
      "checkpoint": {
        "id": "audio.frontend.mel_filters.output",
        "producer": "audio_mel_filters",
        "logical_layout": "mel_frequency",
        "axis_names": ["mel", "frequency"]
      }
    },
    "audio.frontend.log_mel": {
      "op": "audio_log_mel",
      "template_ops": ["audio_log_mel"],
      "phases": {
        "prefill": {
          "contract_id": "audio_whisper_log_mel_from_power_fp32",
          "validation": "validated",
          "evidence": "unittest/test_audio.py PyTorch STFT/log-Mel oracle"
        }
      },
      "checkpoint": {
        "id": "audio.frontend.log_mel.output",
        "producer": "audio_log_mel",
        "logical_layout": "mel_major",
        "axis_names": ["mel", "frame"]
      }
    },
    "audio.frontend.feature_window": {
      "op": "audio_feature_window",
      "template_ops": ["audio_feature_window"],
      "phases": {
        "prefill": {
          "contract_id": "audio_whisper_global_log_mel_feature_window_fp32",
          "validation": "validated",
          "evidence": "unittest/test_audio_encoder.py global STFT/log-Mel slicing and feature-level zero-padding oracle"
        }
      },
      "checkpoint": {
        "id": "audio.frontend.feature_window.output",
        "producer": "audio_feature_window",
        "logical_layout": "mel_major",
        "axis_names": ["mel", "frame"]
      }
    },
    "audio.encoder.stem.conv1": {
      "op": "audio_conv1d",
      "template_ops": ["audio_conv1d_stem_1"],
      "phases": {
        "prefill": {
          "contract_id": "audio_conv1d_channel_major_ascending_fp32",
          "validation": "validated",
          "evidence": "unittest/test_audio_encoder.py Whisper stem-1 PyTorch Conv1D oracle"
        }
      },
      "checkpoint": {
        "id": "audio.encoder.stem.conv1.output",
        "producer": "conv1",
        "logical_layout": "channel_major",
        "axis_names": ["channel", "frame"]
      }
    },
    "audio.encoder.stem.conv2": {
      "op": "audio_conv1d",
      "template_ops": ["audio_conv1d_stem_2"],
      "phases": {
        "prefill": {
          "contract_id": "audio_conv1d_channel_major_ascending_fp32",
          "validation": "validated",
          "evidence": "unittest/test_audio_encoder.py Whisper stem-2 PyTorch Conv1D oracle"
        }
      },
      "checkpoint": {
        "id": "audio.encoder.stem.conv2.output",
        "producer": "conv2",
        "logical_layout": "channel_major",
        "axis_names": ["channel", "frame"]
      }
    },
    "audio.encoder.layout": {
      "op": "layout_transform",
      "template_ops": ["layout_channel_to_token"],
      "phases": {
        "prefill": {
          "contract_id": "layout_channel_to_token_copy_fp32",
          "validation": "validated",
          "evidence": "unittest/test_audio_encoder.py exact channel-major to token-major identity"
        }
      },
      "checkpoint": {
        "id": "audio.encoder.layout.output",
        "producer": "to_token_major",
        "logical_layout": "token_major",
        "axis_names": ["token", "channel"]
      }
    },
    "audio.encoder.position": {
      "op": "position_embeddings",
      "template_ops": ["position_embeddings"],
      "phases": {
        "prefill": {
          "contract_id": "position_embeddings_add_token_major_fp32",
          "validation": "validated",
          "evidence": "unittest/test_vision.py exact learned absolute position addition"
        }
      },
      "checkpoint": {
        "id": "audio.encoder.position.output",
        "producer": "position",
        "logical_layout": "token_major",
        "axis_names": ["token", "channel"]
      }
    },
    "audio.encoder.activation": {
      "operation_interface": "gelu.fp32_inplace.v1",
      "op": "gelu",
      "template_ops": ["gelu"],
      "phases": {
        "prefill": {
          "contract_id": "gelu_erf_fp64_scalar_fp32_storage",
          "validation": "validated",
          "evidence": "unittest/test_audio_encoder.py byte-exact FP64 scalar ERF formula plus observed PyTorch comparison"
        }
      },
      "checkpoint": {
        "id": "audio.encoder.activation.output",
        "producer": "gelu",
        "logical_layout": "contiguous",
        "axis_names": ["element"]
      }
    },
    "audio.encoder.attention.fp32": {
      "op": "attention",
      "template_ops": ["attn"],
      "selector": {
        "config_not_equals": {
          "audio_encoder_attention_reduction_policy": "tiled_f16kv_online_softmax"
        }
      },
      "phases": {
        "prefill": {
          "contract_id": "attention_query_key_scaled_ordered_fp32_packed_k",
          "validation": "validated",
          "evidence": "unittest/test_audio_encoder.py equal-length encoder and unequal-length decoder PyTorch attention oracles"
        }
      },
      "checkpoint": {
        "id": "audio.encoder.layer.{layer}.attention.output",
        "producer": "attn",
        "logical_layout": "head_major",
        "axis_names": ["head", "token", "channel"]
      }
    },
    "audio.encoder.attention.fp16_tiled": {
      "op": "attention",
      "template_ops": ["attn"],
      "selector": {
        "config_equals": {
          "audio_encoder_attention_reduction_policy": "tiled_f16kv_online_softmax"
        }
      },
      "phases": {
        "prefill": {
          "contract_id": "attention_query_key_tiled_f16kv_fp32_online_softmax",
          "validation": "validated",
          "evidence": "Whisper production-shape direct oracle, thread determinism, transcript corpus, and same-host performance gate"
        }
      },
      "checkpoint": {
        "id": "audio.encoder.layer.{layer}.attention.output",
        "producer": "attn",
        "logical_layout": "head_major",
        "axis_names": ["head", "token", "channel"]
      }
    }
  },
  "block_types": {
    "audio_encoder": {
      "sequence": ["header", "body", "footer"],
      "header": [
        {
          "id": "wav_decode",
          "op": "audio_wav_decode",
          "params": {
            "mono_capacity_from_config": "audio_max_source_frames"
          }
        },
        {
          "id": "resample",
          "op": "audio_resample",
          "params": {
            "output_rate_from_config": "audio_sample_rate",
            "radius_from_config": "audio_resample_radius"
          }
        },
        {
          "id": "pad_or_truncate",
          "op": "audio_pad_or_truncate",
          "params": {
            "output_frames_from_config": "audio_sample_extent"
          }
        },
        {
          "id": "stft_tables",
          "op": "audio_stft_tables",
          "params": {
            "n_fft_from_config": "audio_n_fft"
          }
        },
        {
          "id": "stft",
          "op": "audio_stft",
          "params": {
            "n_samples_from_config": "audio_sample_extent",
            "hop_length_from_config": "audio_hop_length",
            "n_frames_from_config": "audio_feature_frames"
          }
        },
        {
          "id": "mel_filters",
          "op": "audio_mel_filters",
          "params": {
            "sample_rate_from_config": "audio_sample_rate",
            "n_fft_from_config": "audio_n_fft",
            "n_mels_from_config": "audio_feature_channels"
          }
        },
        {
          "id": "log_mel",
          "op": "audio_log_mel",
          "params": {
            "n_mels_from_config": "audio_feature_channels",
            "n_frames_from_config": "audio_feature_frames"
          }
        },
        {
          "id": "feature_window",
          "op": "audio_feature_window",
          "params": {
            "sample_rate_from_config": "audio_sample_rate",
            "n_mels_from_config": "audio_feature_channels",
            "n_frames_from_config": "audio_feature_frames"
          }
        },
        {
          "id": "conv1",
          "op": "audio_conv1d_stem_1",
          "params": {
            "input_channels_from_config": "audio_feature_channels",
            "output_channels_from_config": "audio_conv1_output_channels",
            "input_frames_from_config": "audio_feature_frames",
            "output_frames_from_config": "audio_conv1_output_frames",
            "kernel_size_from_config": "audio_conv1_kernel_size",
            "stride_from_config": "audio_conv1_stride",
            "padding_from_config": "audio_conv1_padding"
          }
        },
        {
          "id": "conv1_gelu",
          "op": "gelu",
          "params": {
            "elements_from_config": "audio_conv1_elements"
          },
          "graph_slots": {
            "inputs": {"x": "audio_conv_1"},
            "outputs": {"out": "audio_conv_1"}
          }
        },
        {
          "id": "conv2",
          "op": "audio_conv1d_stem_2",
          "params": {
            "input_channels_from_config": "audio_conv1_output_channels",
            "output_channels_from_config": "audio_conv2_output_channels",
            "input_frames_from_config": "audio_conv1_output_frames",
            "output_frames_from_config": "audio_conv2_output_frames",
            "kernel_size_from_config": "audio_conv2_kernel_size",
            "stride_from_config": "audio_conv2_stride",
            "padding_from_config": "audio_conv2_padding"
          }
        },
        {
          "id": "conv2_gelu",
          "op": "gelu",
          "params": {
            "elements_from_config": "audio_conv2_elements"
          },
          "graph_slots": {
            "inputs": {"x": "audio_conv_2"},
            "outputs": {"out": "audio_conv_2"}
          }
        },
        {
          "id": "to_token_major",
          "op": "layout_channel_to_token",
          "params": {
            "channels_from_config": "audio_conv2_output_channels",
            "frames_from_config": "audio_conv2_output_frames"
          }
        },
        {"id": "position", "op": "position_embeddings"}
      ],
      "body": {
        "type": "dense",
        "ops": [
          {"id": "attn_norm", "op": "layernorm"},
          {
            "id": "q_proj",
            "op": "q_proj",
            "graph_slots": {
              "inputs": {"A": "main_stream"},
              "outputs": {"C": "q_scratch"}
            }
          },
          {
            "id": "k_proj",
            "op": "k_proj",
            "graph_slots": {
              "inputs": {"A": "main_stream"},
              "outputs": {"C": "k_scratch"}
            }
          },
          {
            "id": "v_proj",
            "op": "v_proj",
            "graph_slots": {
              "inputs": {"A": "main_stream"},
              "outputs": {"C": "v_scratch"}
            }
          },
          {
            "id": "attn",
            "op": "attn",
            "params": {
              "query_tokens_from_config": "context_length",
              "key_tokens_from_config": "context_length",
              "attention_scale_from_config": "attention_scale"
            },
            "graph_slots": {
              "inputs": {
                "q": "q_scratch",
                "k": "k_scratch",
                "v": "v_scratch"
              },
              "outputs": {
                "out": "attn_scratch"
              }
            }
          },
          {
            "id": "out_proj",
            "op": "out_proj",
            "graph_slots": {
              "inputs": {"A": "attn_scratch"},
              "outputs": {"C": "main_stream"}
            }
          },
          {"id": "attn_residual", "op": "residual_add"},
          {"id": "ffn_norm", "op": "layernorm"},
          {
            "id": "mlp_up",
            "op": "mlp_up",
            "graph_slots": {
              "inputs": {"A": "main_stream"},
              "outputs": {"C": "mlp_scratch"}
            }
          },
          {"id": "mlp_gelu", "op": "gelu"},
          {
            "id": "mlp_down",
            "op": "mlp_down",
            "graph_slots": {
              "inputs": {"A": "mlp_scratch"},
              "outputs": {"C": "main_stream"}
            }
          },
          {"id": "mlp_residual", "op": "residual_add"}
        ]
      },
      "footer": [
        {"id": "final_norm", "op": "layernorm"}
      ]
    }
  },
  "sequence": ["audio_encoder"]
}
