{
  "version": 2,
  "name": "gemma4",
  "family": "gemma4",
  "serving": {
    "schema": "cke.circuit_serving.v1",
    "profile_ref": "serving_profiles/gemma4_v1.json",
    "default_variant": "chat"
  },
  "projection_inputs": {
    "q_proj": {"x": "main_stream_q8"},
    "k_proj": {"x": "main_stream_q8"},
    "v_proj": {"x": "main_stream_q8"}
  },
  "flags": {
    "use_qkv_bias": false,
    "activation": "geglu",
    "rope": "rope",
    "tokenizer": "bpe",
    "scale_embeddings_sqrt_dim": true,
    "has_qk_norm": true,
    "post_attention_norm": true,
    "attention": "hybrid_sliding_window"
  },
  "activation_bindings": {
    "mlp_compact": "mlp_compact"
  },
  "activation_buffers": {
    "mlp_compact": {
      "shape": [
        {"config": "execution_extent"},
        {"config": "intermediate_size"}
      ]
    }
  },
  "contract": {
    "provider_numerical_requirements": {
      "gemma4_per_layer_prepare": "gemma4_prepare_llama_cpu_bf16_input_rne_v2",
      "gemma4_per_layer_embed": "gemma4_embed_llama_cpu_segmented_projection_norm_v2"
    },
    "tokenizer_contract": {
      "tokenizer_type": "bpe",
      "bos_policy": "model_defined",
      "eos_policy": "model_defined",
      "special_tokens": {
        "source": "manifest_or_gguf"
      }
    },
    "chat_contract": {
      "version": 1,
      "name": "gemma4",
      "raw_prompt_allowed": false,
      "turn_prefix": "<|turn>{role}\n",
      "turn_suffix": "<turn|>\n",
      "assistant_generation_prefix": "<|turn>model\n",
      "role_labels": {
        "system": "system",
        "user": "user",
        "assistant": "model"
      },
      "system_prompt_mode": "dedicated_turn",
      "system_prompt_separator": "\n\n",
      "default_system_prompt": "",
      "system_prompt_prefix_by_thinking_mode": {
        "visible": "<|think|>\n"
      },
      "inject_default_system_prompt": false,
      "thinking_mode_default": "visible",
      "force_bos_text_if_tokenizer_add_bos_false": "<bos>",
      "last_user_prefix": "",
      "last_user_prefix_suppression_markers": [],
      "stop_text_markers": [
        "<turn|>",
        "<eos>"
      ],
      "token_stop_markers": [
        "<turn|>",
        "<eos>"
      ],
      "template_markers": [
        "<|turn>",
        "<turn|>",
        "<|image|>"
      ],
      "min_response_tokens": 8,
      "image_begin_marker": "<|image>",
      "image_end_marker": "<image|>"
    },
    "attention_contract": {
      "rope_layout": "split",
      "rope_type": "rope",
      "qk_norm": true,
      "kv_layout": "layer_major_kv_cache",
      "attn_variant": "hybrid_sliding_attention",
      "layer_policy_config_key": "layer_attention_plan",
      "layer_kind_config_key": "layer_kinds",
      "kv_policy_config_key": "layer_kv_policy",
      "kv_source_config_key": "layer_kv_source",
      "sliding_window_config_key": "layer_sliding_window",
      "rope_kind_config_key": "layer_rope_kind",
      "rope_param_mode": "per_layer_direct"
    },
    "block_contract": {
      "norm_type": "rmsnorm",
      "mlp_formula": "gate_up -> geglu -> down",
      "activation": "geglu",
      "qkv_bias": false,
      "body_type": "hybrid_sliding_attention"
    },
    "logits_contract": {
      "final_norm": "rmsnorm",
      "lm_head": "weight_tying",
      "logits_layout": "auto"
    },
    "quant_contract": {
      "kernel_select": "weight_dtype_registry",
      "activation_dtype": "fp32_or_q8_path",
      "per_tensor_mixed_quant": true
    },
    "runtime_invariants": {
      "required_call_args": {
        "kv_cache_batch_copy": [
          "activation:k_src",
          "activation:v_src",
          "output:k_dst",
          "output:v_dst",
          "dim:_kv_copy_bytes"
        ]
      }
    },
  "weight_policy": {
    "op_bindings": [
      {
        "section": "body",
        "op": "rope_qk",
        "weights": ["rope_freqs"],
        "required": true
      },
      {
        "section": "body",
        "op": "rope_q",
        "weights": ["rope_freqs"],
        "required": true
      }
    ],
    "ignore": [
        {
          "pattern": "layer.*.v_norm_gamma",
          "reason": "The selected V RMSNorm kernel is unweighted; GGUF compatibility tensors are intentionally not consumed."
        }
      ]
    },
    "multimodal_bridge": {
      "image_begin_marker": "<|image>",
      "image_end_marker": "<image|>",
      "runtime_policy": "decode_staged",
      "generation_policy": "incremental_decode_after_prefill",
      "cache_policy": "persistent_decoder_kv",
      "prefill_schedules": {
        "segmented_append": {
          "segments": ["text_before", "visual", "text_after"],
          "cache_transition": "append_preserve",
          "position_transition": "runtime_offset",
          "projection_row_group_boundaries": {
            "policy": "restart_each_segment",
            "operations": ["q_proj", "k_proj", "v_proj", "out_proj", "mlp_gate_up", "mlp_down", "gemma4_per_layer_embed"],
            "text_after_row_group": "single_token"
          }
        }
      }
    }
  },
  "required_contracts": {
    "decoder.attention.gemma4_full": {
      "op": "attention",
      "template_ops": ["attn", "attn_shared_kv"],
      "phases": {
        "prefill": {
          "requires": {
            "execution.phase": "prefill",
            "execution.prefill_batching": "segmented_append",
            "tensor.q.dtype": "fp32",
            "tensor.kv.dtype": "fp16",
            "tensor.layout": "head_major",
            "numerics.attention_reduction": "f16_flash_auto_qtile64_regular_tail_noscale"
          },
          "validation": "observed",
          "evidence": "Gemma4 uses unit-scale attention and persistent FP16 K/V across multimodal prefill segments."
        },
        "decode": {
          "requires": {
            "execution.phase": "decode",
            "tensor.q.dtype": "fp32",
            "tensor.kv.dtype": "fp16",
            "tensor.layout": "head_major",
            "numerics.attention_reduction": "f16_regular_fp32_noscale"
          },
          "validation": "observed",
          "evidence": "Gemma4 decode retains unit-scale attention over the persistent FP16 cache."
        }
      }
    },
    "decoder.attention.gemma4_sliding": {
      "op": "attention_sliding",
      "template_ops": ["attn_sliding", "attn_sliding_shared_kv"],
      "phases": {
        "prefill": {
          "requires": {
            "execution.phase": "prefill",
            "execution.prefill_batching": "segmented_append",
            "tensor.q.dtype": "fp32",
            "tensor.kv.dtype": "fp16",
            "tensor.layout": "head_major",
            "numerics.attention_reduction": "f16_flash_auto_qtile64_regular_tail_noscale"
          },
          "validation": "observed",
          "evidence": "Gemma4 sliding prefill uses the layer-declared live range of the persistent FP16 cache."
        },
        "decode": {
          "requires": {
            "execution.phase": "decode",
            "tensor.q.dtype": "fp32",
            "tensor.kv.dtype": "fp16",
            "tensor.layout": "head_major",
            "numerics.attention_reduction": "f16_regular_fp32_noscale"
          },
          "validation": "observed",
          "evidence": "Gemma4 sliding decode uses the layer-declared live cache range with unit attention scale."
        }
      }
    }
  },
  "required_numerical_contracts": {
    "decoder.rmsnorm": {
      "operation_interface": "rmsnorm.fp32.v1",
      "op": "rmsnorm",
      "template_ops": ["attn_norm", "post_attention_norm", "ffn_norm", "post_ffn_norm", "final_rmsnorm"],
      "phases": {
        "prefill": {
          "contract_id": "rmsnorm_llama_cpu_production_fp32_output",
          "validation": "validated",
          "evidence": "Exact-input Gemma4 decoder layer-0 normalization replay against pinned llama.cpp CPU capture; serial and parallel providers have independent row parity tests."
        },
        "decode": {
          "contract_id": "rmsnorm_llama_cpu_production_fp32_output",
          "validation": "validated",
          "evidence": "Exact-input Gemma4 decoder layer-0 normalization replay against pinned llama.cpp CPU capture; serial and parallel providers have independent row parity tests."
        }
      },
      "checkpoint": {
        "id": "decoder.layer.{layer}.rmsnorm.output",
        "producer": "rmsnorm",
        "logical_layout": "token_major",
        "axis_names": ["token", "channel"]
      }
    },
    "decoder.qk_norm": {
      "operation_interface": "qk_norm.fp32_inplace.v1",
      "op": "qk_norm",
      "template_ops": ["qk_norm"],
      "phases": {
        "prefill": {
          "contract_id": "rmsnorm_llama_cpu_production_fp32_output",
          "validation": "validated",
          "evidence": "Pinned Gemma4 mixed-prefix replay: exact projected Q/K inputs produce bit-exact normalized Q/K with the llama-production provider; generic RMSNorm straddles FP16 K-cache rounding midpoints."
        },
        "decode": {
          "contract_id": "rmsnorm_llama_cpu_production_fp32_output",
          "validation": "validated",
          "evidence": "Single-token decode uses the same per-head llama.cpp-compatible normalization contract as prefill."
        }
      },
      "checkpoint": {
        "id": "decoder.layer.{layer}.qk_norm.output",
        "producer": "qk_norm",
        "logical_layout": "head_major",
        "axis_names": ["head", "token", "channel"]
      }
    }
  },
  "kernels": {
    "attn_norm": "rmsnorm_forward_llama_production",
    "post_attention_norm": "rmsnorm_forward_llama_production",
    "ffn_norm": "rmsnorm_forward_llama_production",
    "post_ffn_norm": "rmsnorm_forward_llama_production",
    "final_rmsnorm": "rmsnorm_forward_llama_production",
    "qk_norm": "qk_norm_forward_llama_production",
    "geglu": "geglu_forward_ggml_native",
    "rope_qk": "rope_forward_qk_split_llama",
    "rope_q": "rope_forward_q_gemma4",
    "rope_init": "rope_precompute_cache_split",
    "attn_prefill": "attention_forward_causal_head_major_gqa_prefill_append_f16cache_gemma4",
    "attn_decode": "attention_forward_decode_head_major_gqa_f16cache_gemma4_contract",
    "attn_sliding_prefill": "attention_forward_causal_head_major_gqa_prefill_append_f16cache_sliding_gemma4",
    "attn_sliding_decode": "attention_forward_decode_head_major_gqa_f16cache_sliding_gemma4_contract",
    "attn_shared_kv_prefill": "attention_forward_causal_head_major_gqa_prefill_append_f16cache_gemma4",
    "attn_shared_kv_decode": "attention_forward_decode_head_major_gqa_f16cache_gemma4_contract",
    "attn_sliding_shared_kv_prefill": "attention_forward_causal_head_major_gqa_prefill_append_f16cache_sliding_gemma4",
    "attn_sliding_shared_kv_decode": "attention_forward_decode_head_major_gqa_f16cache_sliding_gemma4_contract"
  },
  "sequence": [
    "decoder"
  ],
  "block_types": {
    "decoder": {
      "sequence": [
        "header",
        "body",
        "footer"
      ],
      "header": [
        "bpe_tokenizer",
        "dense_embedding_lookup",
        "gemma4_per_layer_prepare"
      ],
      "body": {
        "type": "hybrid_sliding_attention",
        "kind_config_key": "layer_kinds",
        "default_kind": "sliding_attention",
        "quant_aliases_common": {
          "ln1_gamma": "attn_norm",
          "ln2_gamma": "ffn_norm",
          "post_attention_norm": "attn_post_norm",
          "post_ffn_norm": "ffn_post_norm",
          "w1": "ffn_gate",
          "w3": "ffn_up",
          "w2": "ffn_down"
        },
        "quant_aliases_by_kind": {
          "sliding_attention_kv": {
            "wq": "attn_q",
            "wk": "attn_k",
            "wv": "attn_v",
            "wo": "attn_output",
            "q_norm": "attn_q_norm",
            "k_norm": "attn_k_norm"
          },
          "full_attention_kv": {
            "wq": "attn_q",
            "wk": "attn_k",
            "wv": "attn_v",
            "wo": "attn_output",
            "q_norm": "attn_q_norm",
            "k_norm": "attn_k_norm"
          },
          "sliding_attention_shared_kv": {
            "wq": "attn_q",
            "wo": "attn_output",
            "q_norm": "attn_q_norm"
          },
          "full_attention_shared_kv": {
            "wq": "attn_q",
            "wo": "attn_output",
            "q_norm": "attn_q_norm"
          }
        },
        "ops_by_kind": {
          "sliding_attention_kv": [
            "attn_norm",
            "q_proj",
            "k_proj",
            "v_proj",
            "v_norm",
            "qk_norm",
            "rope_qk",
            "attn_sliding",
            "out_proj",
            "post_attention_norm",
            "residual_add",
            "ffn_norm",
            "mlp_gate_up",
            {"op":"geglu","graph_slots":{"inputs":{"x":"mlp_scratch"},"outputs":{"out":"mlp_compact"}}},
            {"op":"mlp_down","graph_slots":{"inputs":{"x":"mlp_compact"}}},
            "post_ffn_norm",
            "residual_add",
            "gemma4_per_layer_embed"
          ],
          "full_attention_kv": [
            "attn_norm",
            "q_proj",
            "k_proj",
            "v_proj",
            "v_norm",
            "qk_norm",
            "rope_qk",
            "attn",
            "out_proj",
            "post_attention_norm",
            "residual_add",
            "ffn_norm",
            "mlp_gate_up",
            {"op":"geglu","graph_slots":{"inputs":{"x":"mlp_scratch"},"outputs":{"out":"mlp_compact"}}},
            {"op":"mlp_down","graph_slots":{"inputs":{"x":"mlp_compact"}}},
            "post_ffn_norm",
            "residual_add",
            "gemma4_per_layer_embed"
          ],
          "sliding_attention_shared_kv": [
            "attn_norm",
            "q_proj",
            "q_norm",
            "rope_q",
            "attn_sliding_shared_kv",
            "out_proj",
            "post_attention_norm",
            "residual_add",
            "ffn_norm",
            "mlp_gate_up",
            {"op":"geglu","graph_slots":{"inputs":{"x":"mlp_scratch"},"outputs":{"out":"mlp_compact"}}},
            {"op":"mlp_down","graph_slots":{"inputs":{"x":"mlp_compact"}}},
            "post_ffn_norm",
            "residual_add",
            "gemma4_per_layer_embed"
          ],
          "full_attention_shared_kv": [
            "attn_norm",
            "q_proj",
            "q_norm",
            "rope_q",
            "attn_shared_kv",
            "out_proj",
            "post_attention_norm",
            "residual_add",
            "ffn_norm",
            "mlp_gate_up",
            {"op":"geglu","graph_slots":{"inputs":{"x":"mlp_scratch"},"outputs":{"out":"mlp_compact"}}},
            {"op":"mlp_down","graph_slots":{"inputs":{"x":"mlp_compact"}}},
            "post_ffn_norm",
            "residual_add",
            "gemma4_per_layer_embed"
          ]
        }
      },
      "footer": [
        "final_rmsnorm",
        "weight_tying",
        "logits",
        "final_logit_softcap"
      ]
    }
  }
}
