{
  "version": 2,
  "name": "cohere2",
  "family": "cohere2",
  "flags": {
    "activation": "swiglu",
    "rope": "rope",
    "tokenizer": "bpe",
    "attention": "three_sliding_one_full",
    "parallel_attention_mlp": true
  },
  "activation_bindings": {
    "main_stream": "embedded_input",
    "normalized_stream": "normalized_input",
    "attention_residual": "residual",
    "attention_output": "layer_output"
  },
  "activation_buffers": {
    "normalized_input": {
      "shape": [
        {"config": "execution_extent"},
        {"config": "embed_dim"}
      ]
    }
  },
  "contract": {
    "tokenizer_contract": {
      "tokenizer_type": "bpe",
      "bos_policy": "model_defined",
      "eos_policy": "model_defined",
      "special_tokens": {"source": "manifest_or_gguf"}
    },
    "chat_contract": {
      "version": 1,
      "name": "cohere2",
      "raw_prompt_allowed": false,
      "conversation_prefix": "<|START_OF_TURN_TOKEN|><|SYSTEM_TOKEN|><|END_OF_TURN_TOKEN|>",
      "turn_prefix": "<|START_OF_TURN_TOKEN|><|{role}_TOKEN|>",
      "turn_suffix": "<|END_OF_TURN_TOKEN|>",
      "turn_prefix_by_role": {
        "system": "<|START_OF_TURN_TOKEN|><|SYSTEM_TOKEN|>",
        "user": "<|START_OF_TURN_TOKEN|><|USER_TOKEN|>",
        "assistant": "<|START_OF_TURN_TOKEN|><|CHATBOT_TOKEN|>"
      },
      "assistant_generation_prefix": "<|START_OF_TURN_TOKEN|><|CHATBOT_TOKEN|><|START_RESPONSE|>",
      "role_labels": {
        "system": "SYSTEM",
        "user": "USER",
        "assistant": "CHATBOT"
      },
      "system_prompt_mode": "dedicated_turn",
      "system_prompt_separator": "\n\n",
      "default_system_prompt": "",
      "inject_default_system_prompt": false,
      "stop_text_markers": ["<|END_RESPONSE|>", "<|END_OF_TURN_TOKEN|>"],
      "token_stop_markers": ["<|END_RESPONSE|>", "<|END_OF_TURN_TOKEN|>"],
      "template_markers": [
        "<|START_OF_TURN_TOKEN|>",
        "<|SYSTEM_TOKEN|>",
        "<|USER_TOKEN|>",
        "<|CHATBOT_TOKEN|>",
        "<|START_RESPONSE|>",
        "<|END_RESPONSE|>",
        "<|END_OF_TURN_TOKEN|>"
      ],
      "min_response_tokens": 8
    },
    "attention_contract": {
      "causal": true,
      "rope_layout": "split",
      "rope_type": "rope_on_sliding_layers_only",
      "qk_norm": false,
      "kv_layout": "layer_major_kv_cache",
      "attn_variant": "hybrid_sliding_attention",
      "layer_kind_config_key": "layer_kinds",
      "sliding_window_config_key": "sliding_window"
    },
    "block_contract": {
      "norm_type": "layernorm",
      "body_type": "parallel_attention_swiglu",
      "activation": "swiglu",
      "mlp_formula": "layernorm(x) -> gate_up -> silu_mul -> down",
      "residual_formula": "x + mlp(layernorm(x)) + attention(layernorm(x))",
      "parallel_branches": ["attention", "mlp"]
    },
    "logits_contract": {
      "final_norm": "layernorm",
      "lm_head": "weight_tying",
      "scale_config_key": "logit_scale",
      "logits_layout": "auto"
    },
    "quant_contract": {
      "kernel_select": "weight_dtype_registry",
      "activation_dtype": "fp32_or_q8_path",
      "per_tensor_mixed_quant": true
    },
    "runtime_invariants": {"required_call_args": {}},
    "weight_policy": {
      "ignore": [
        {
          "pattern": "layer.*.ln2_gamma",
          "reason": "Cohere2 has one shared pre-block LayerNorm; the canonical dense converter retains a duplicate compatibility copy."
        },
        {
          "pattern": "layer.*.ln2_beta",
          "reason": "Cohere2 has one shared pre-block LayerNorm; the canonical dense converter retains a duplicate zero-bias compatibility copy."
        }
      ]
    }
  },
  "kernels": {
    "layernorm": "layernorm_fp32_exact",
    "rope_init": "rope_precompute_cache_llama_cpu",
    "rope_qk": "rope_forward_qk_pairwise",
    "rope_qk_decode": "rope_forward_qk_pairwise_llama_cpu",
    "attn": "attention_forward_causal_head_major_gqa_flash_strided",
    "attn_decode": "attention_forward_decode_head_major_gqa_flash",
    "attn_sliding": "attention_forward_causal_head_major_gqa_flash_strided_sliding",
    "attn_sliding_decode": "attention_forward_decode_head_major_gqa_flash_sliding",
    "final_logit_scale": "final_logit_scale_f32"
  },
  "sequence": ["decoder"],
  "block_types": {
    "decoder": {
      "sequence": ["header", "body", "footer"],
      "header": ["bpe_tokenizer", "dense_embedding_lookup"],
      "body": {
        "type": "hybrid_sliding_attention",
        "kind_config_key": "layer_kinds",
        "default_kind": "sliding_attention",
        "ops_by_kind": {
          "sliding_attention": [
            {"op":"residual_save","graph_slots":{"inputs":{"src":"main_stream"},"outputs":{"dst":"attention_residual"}}},
            {"op":"layernorm","auto_residual_save":false,"graph_slots":{"inputs":{"input":"main_stream"},"outputs":{"output":"normalized_stream"}}},
            {"op":"qkv_proj","graph_slots":{"inputs":{"x":"normalized_stream"}}},
            "rope_qk",
            "attn_sliding",
            {"op":"out_proj","graph_slots":{"inputs":{"x":"attn_scratch"},"outputs":{"y":"attention_output"}}},
            {"op":"mlp_gate_up","graph_slots":{"inputs":{"x":"normalized_stream"},"outputs":{"y":"mlp_scratch"}}},
            "silu_mul",
            {"op":"mlp_down","graph_slots":{"inputs":{"x":"mlp_scratch"},"outputs":{"y":"main_stream"}}},
            {"op":"residual_add","graph_slots":{"inputs":{"a":"main_stream","b":"attention_residual"},"outputs":{"out":"main_stream"}}},
            {"op":"residual_add","graph_slots":{"inputs":{"a":"main_stream","b":"attention_output"},"outputs":{"out":"main_stream"}}}
          ],
          "full_attention": [
            {"op":"residual_save","graph_slots":{"inputs":{"src":"main_stream"},"outputs":{"dst":"attention_residual"}}},
            {"op":"layernorm","auto_residual_save":false,"graph_slots":{"inputs":{"input":"main_stream"},"outputs":{"output":"normalized_stream"}}},
            {"op":"qkv_proj","graph_slots":{"inputs":{"x":"normalized_stream"}}},
            "attn",
            {"op":"out_proj","graph_slots":{"inputs":{"x":"attn_scratch"},"outputs":{"y":"attention_output"}}},
            {"op":"mlp_gate_up","graph_slots":{"inputs":{"x":"normalized_stream"},"outputs":{"y":"mlp_scratch"}}},
            "silu_mul",
            {"op":"mlp_down","graph_slots":{"inputs":{"x":"mlp_scratch"},"outputs":{"y":"main_stream"}}},
            {"op":"residual_add","graph_slots":{"inputs":{"a":"main_stream","b":"attention_residual"},"outputs":{"out":"main_stream"}}},
            {"op":"residual_add","graph_slots":{"inputs":{"a":"main_stream","b":"attention_output"},"outputs":{"out":"main_stream"}}}
          ]
        }
      },
      "footer": [
        "layernorm",
        "weight_tying",
        "logits",
        "final_logit_scale"
      ]
    }
  }
}
