{
  "version": 2,
  "name": "glm4",
  "family": "glm",
  "projection_inputs": {"q_proj":{"x":"main_stream_q8"},"k_proj":{"x":"main_stream_q8"},"v_proj":{"x":"main_stream_q8"}},
  "flags": {
    "use_qkv_bias": true,
    "activation": "swiglu",
    "rope": "rope",
    "tokenizer": "bpe",
    "post_attention_norm": true,
    "post_ffn_norm": true
  },
  "contract": {
    "tokenizer_contract": {
      "tokenizer_type": "bpe",
      "bos_policy": "model_defined",
      "eos_policy": "model_defined",
      "special_tokens": {
        "source": "manifest_or_gguf"
      }
    },
    "chat_contract": {
      "version": 1,
      "name": "glm4",
      "raw_prompt_allowed": false,
      "turn_prefix": "<|{role}|>\n",
      "turn_suffix": "\n",
      "assistant_generation_prefix": "<|assistant|>",
      "role_labels": {
        "system": "system",
        "user": "user",
        "assistant": "assistant"
      },
      "system_prompt_mode": "dedicated_turn",
      "system_prompt_separator": "\n\n",
      "default_system_prompt": "",
      "inject_default_system_prompt": false,
      "force_bos_text_if_tokenizer_add_bos_false": "[gMASK]<sop>\n",
      "last_user_prefix": "",
      "last_user_prefix_suppression_markers": [],
      "stop_text_markers": [
        "<|user|>",
        "<|observation|>",
        "<|assistant|>"
      ],
      "token_stop_markers": [
        "<|user|>",
        "<|observation|>"
      ],
      "template_markers": [
        "[gMASK]",
        "<|system|>",
        "<|user|>",
        "<|assistant|>",
        "<|observation|>"
      ],
      "min_response_tokens": 8
    },
    "attention_contract": {
      "rope_layout": "pairwise",
      "rope_type": "rope",
      "qk_norm": false,
      "kv_layout": "layer_major_kv_cache",
      "decode_kv_cache_dtype": "fp16",
      "attn_variant": "dense",
      "partial_rotary": true
    },
    "block_contract": {
      "norm_type": "rmsnorm",
      "mlp_formula": "gate_up -> silu_mul -> down",
      "activation": "swiglu",
      "qkv_bias": true
    },
    "logits_contract": {
      "final_norm": "rmsnorm",
      "lm_head": "weight_tying",
      "logits_layout": "auto"
    },
    "quant_contract": {
      "kernel_select": "weight_dtype_registry",
      "activation_dtype": "fp32_or_q8_path",
      "per_tensor_mixed_quant": true
    },
    "runtime_invariants": {
      "required_call_args": {
        "kv_cache_batch_copy": [
          "activation:k_src",
          "activation:v_src",
          "output:k_dst",
          "output:v_dst",
          "dim:_kv_copy_bytes"
        ]
      }
    }
  },
  "required_contracts": {
    "decoder.attention": {
      "op": "attention",
      "template_ops": ["attn"],
      "selector": {
        "config_equals": {
          "decode_kv_cache_dtype": "fp16"
        }
      },
      "phases": {
        "prefill": {
          "requires": {
            "execution.phase": "prefill",
            "execution.prefill_batching": "batch_append",
            "tensor.q.dtype": "fp32",
            "tensor.kv.dtype": "fp16",
            "tensor.layout": "head_major",
            "numerics.attention_reduction": "f16_online_single_range"
          },
          "validation": "observed",
          "evidence": "GLM-4 production prefill writes FP16 K/V for persistent decode; generated-IR and cache write-through tests guard the phase boundary."
        },
        "decode": {
          "requires": {
            "execution.phase": "decode",
            "tensor.q.dtype": "fp32",
            "tensor.kv.dtype": "fp16",
            "tensor.layout": "head_major",
            "numerics.attention_reduction": "f16_online_fp32_merge"
          },
          "validation": "validated",
          "evidence": "Real GLM-4 H=32/Hkv=2/D=128 captures and the llama.cpp production flash oracle are byte-exact at the attention boundary."
        }
      }
    }
  },
  "kernels": {
    "rmsnorm": "rmsnorm_forward_llama_production",
    "post_ffn_norm": "rmsnorm_forward_llama_production",
    "rope_init": "rope_precompute_cache_llama_cpu",
    "rope_qk": "rope_forward_qk_pairwise",
    "rope_qk_decode": "rope_forward_qk_pairwise_llama_cpu",
    "rope_qk_prefill": "rope_forward_qk_pairwise",
    "attn_decode": "attention_forward_decode_head_major_gqa_flash"
  },
  "sequence": [
    "decoder"
  ],
  "block_types": {
    "decoder": {
      "sequence": [
        "header",
        "body",
        "footer"
      ],
      "header": [
        "bpe_tokenizer",
        "dense_embedding_lookup"
      ],
      "body": {
        "type": "dense",
        "ops": [
          "rmsnorm",
          {
            "op": "qkv_proj",
            "graph_slots": {
              "inputs": {
                "x": "main_stream"
              }
            }
          },
          "rope_qk",
          "attn",
          {
            "op": "out_proj",
            "graph_slots": {
              "inputs": {
                "x": "attn_scratch"
              }
            }
          },
          "post_attention_norm",
          "residual_add",
          "rmsnorm",
          {
            "op": "mlp_gate_up",
            "graph_slots": {
              "inputs": {
                "x": "main_stream"
              }
            }
          },
          "silu_mul",
          {
            "op": "mlp_down",
            "graph_slots": {
              "inputs": {
                "A": "mlp_scratch"
              },
              "outputs": {
                "C": "main_stream"
              }
            }
          },
          "post_ffn_norm",
          "residual_add"
        ]
      },
      "footer": [
        "rmsnorm",
        "weight_tying",
        {
          "op": "logits",
          "graph_slots": {
            "inputs": {
              "x": "main_stream"
            }
          }
        }
      ]
    }
  }
}
