{
  "version": 2,
  "name": "qwen4_exp",
  "family": "qwen38_flash_next",
  "projection_inputs": {
    "recurrent_qkv_proj": {"x": "main_stream_q8"},
    "recurrent_gate_proj": {"x": "main_stream_q8"},
    "recurrent_alpha_proj": {"x": "main_stream_q8"},
    "recurrent_beta_proj": {"x": "main_stream_q8"},
    "q_gate_proj": {"x": "main_stream_q8"},
    "q_proj": {"x": "main_stream_q8"},
    "k_proj": {"x": "main_stream_q8"},
    "v_proj": {"x": "main_stream_q8"}
  },
  "kernels": {
    "hyper_stream_expand": "hyper_stream_expand_f32",
    "qsa_index_select": "qsa_index_select_bf16",
    "qsa_attention": "qsa_attention_bf16",
    "attn_prefill": "attention_forward_causal_head_major_gqa_flash_compact_token_output",
    "attn_decode": "attention_forward_decode_head_major_gqa_regular",
    "full_softmax_topk_router": "moe_softmax_topk_router_pytorch_bf16",
    "hyper_inject_attn": "hyper_stream_inject_bf16",
    "hyper_inject_mlp": "hyper_stream_inject_bf16"
  },
  "activation_bindings": {
    "hyper_stream": "hyper_stream",
    "attn_hyper_injection": "attn_hyper_injection",
    "mlp_hyper_injection": "mlp_hyper_injection",
    "ple_embedding": "ple_embedding",
    "ple_embedding_q8": "main_stream_q8",
    "ple_key": "ple_key",
    "ple_value": "ple_value",
    "ple_token_state": "ple_token_state",
    "ple_conv_state": "ple_conv_state",
    "qsa_index_projected": "qsa_index_projected",
    "qsa_selected_indices": "qsa_selected_indices",
    "qsa_index_key_cache": "qsa_index_key_cache",
    "moe_output_stream": "layer_output"
  },
  "activation_buffers": {
    "hyper_stream": {"shape":[{"config":"execution_extent"},{"mul":[{"config":"hc_count"},{"config":"embed_dim"}]}]},
    "attn_hyper_injection": {"shape":[{"config":"execution_extent"},{"config":"hc_count"}]},
    "mlp_hyper_injection": {"shape":[{"config":"execution_extent"},{"config":"hc_count"}]},
    "ple_embedding": {"shape":[{"config":"execution_extent"},{"config":"ple_embed_dim"}]},
    "ple_key": {"shape":[{"config":"execution_extent"},{"mul":[{"config":"hc_count"},{"config":"embed_dim"}]}]},
    "ple_value": {"shape":[{"config":"execution_extent"},{"config":"embed_dim"}]},
    "ple_token_state": {"shape":[{"config":"num_layers"},{"config":"ple_token_history"}]},
    "ple_conv_state": {"shape":[{"config":"num_layers"},{"config":"ple_conv_history"},{"mul":[{"config":"hc_count"},{"config":"embed_dim"}]}]},
    "qsa_index_projected": {"shape":[{"config":"execution_extent"},{"config":"qsa_index_proj_dim"}]},
    "qsa_selected_indices": {"shape":[{"config":"execution_extent"},{"config":"qsa_selection_width"}]},
    "qsa_index_key_cache": {"shape":[{"config":"num_layers"},{"config":"context_length"},{"config":"indexer_head_dim"}]}
  },
  "flags": {
    "use_qkv_bias": false,
    "activation": "swiglu",
    "rope": "rope",
    "tokenizer": "bpe",
    "has_qk_norm": true,
    "prefill_policy": "batched",
    "residual_topology": "four_stream_gated_hyper_connection",
    "attention_topology": "deltanet_or_qsa_sparse",
    "mlp_topology": "packed_moe_plus_gated_shared_expert"
  },
  "contract": {
    "prefill_terminal_rows": {
      "version": 1,
      "selector": {
        "config_not_equals": {"recurrent_qkv_weight_dtype": "bf16"}
      },
      "start_before": "moe_router",
      "suffix": [
        ["moe_router"], ["full_softmax_topk_router"],
        ["moe_swiglu_expert_mlp", "moe_swiglu_packed_expert_mlp"],
        ["gated_shared_swiglu_expert_mlp"], ["hyper_inject_mlp"],
        ["hyper_mix_final"], ["quantize_final_output"], ["logits"]
      ],
      "live_inputs": [
        {"op":"moe_router","argument":"A","width_args":["K"]},
        {"op":"hyper_inject_mlp","argument":"hyper_input","width_args":["streams","hidden_dim"]},
        {"op":"hyper_inject_mlp","argument":"injection_weight","width_args":["streams"]}
      ]
    },
    "weight_policy": {
      "ignore": [
        {
          "pattern": "layer.*.index_*",
          "reason": "QSA index projections are inactive when sparse compression is disabled",
          "when": {"config_key": "indexer_compress_ratio", "equals": 0}
        }
      ],
      "op_bindings": [
        {"section":"body","op":"ple_ngram_embed","weights":["ple_ngram_embedding","ple_layer_multipliers","ple_ngram_heads_offsets","ple_ngram_heads_vocab_sizes"]},
        {"section":"body","op":"ple_key_proj","weights":["ple_key"]},
        {"section":"body","op":"ple_value_proj","weights":["ple_value"]},
        {"section":"body","op":"ple_gate_conv_inject","weights":["ple_norm_key","ple_norm_query","ple_norm_conv","ple_conv"]},
        {"section":"body","op":"qsa_index_proj","weights":["index_qk"]},
        {"section":"body","op":"qsa_index_select","weights":["index_q_norm","index_k_norm"]},
        {"section":"body","op":"moe_swiglu_packed_expert_mlp","weights":["moe_expert_gate_up","moe_expert_down"]},
        {"section":"body","op":"moe_swiglu_expert_mlp","weights":["moe_expert_gate","moe_expert_up","moe_expert_down"]},
        {"section":"body","op":"hyper_mix_attn","weights":["attn_hyper_norm","attn_hyper_mix_down","attn_hyper_mix_up","attn_hyper_inject"]},
        {"section":"body","op":"hyper_mix_mlp","weights":["mlp_hyper_norm","mlp_hyper_mix_down","mlp_hyper_mix_up","mlp_hyper_inject"]},
        {"section":"footer","op":"hyper_mix_final","weights":["final_hyper_norm","final_hyper_mix_down","final_hyper_mix_up"]}
      ]
    },
    "runtime_defaults": {
      "prefill_chunk_length": 4096,
      "logits_layout": "last",
      "prefill_gateup_swiglu_fusion_default": false
    },
    "tokenizer_contract": {
      "tokenizer_type": "bpe",
      "bos_policy": "model_defined",
      "eos_policy": "model_defined",
      "special_tokens": {"source": "manifest_or_gguf"}
    },
    "chat_contract": {
      "version": 1,
      "name": "qwen4_exp",
      "raw_prompt_allowed": false,
      "turn_prefix": "<|im_start|>{role}\n",
      "turn_suffix": "<|im_end|>\n",
      "assistant_generation_prefix": "<|im_start|>assistant\n",
      "assistant_generation_prefix_by_thinking_mode": {
        "visible": "<|im_start|>assistant\n<think>\n",
        "suppressed": "<|im_start|>assistant\n<think>\n\n</think>\n\n"
      },
      "role_labels": {"system": "system", "user": "user", "assistant": "assistant"},
      "system_prompt_mode": "dedicated_turn",
      "system_prompt_separator": "\n\n",
      "default_system_prompt": "",
      "inject_default_system_prompt": false,
      "thinking_mode_default": "visible",
      "stop_text_markers": ["<|im_end|>"],
      "token_stop_markers": ["<|im_end|>"],
      "template_markers": ["<|im_start|>", "<|im_end|>", "<think>", "</think>"],
      "min_response_tokens": 8
    },
    "attention_contract": {
      "rope_layout": "split",
      "rope_type": "rope",
      "qk_norm": "qsa_layers_only",
      "kv_layout": "qsa_layer_major_kv_cache",
      "attn_variant": "hybrid_deltanet_qsa",
      "layer_policy_config_key": "layer_execution_plan",
      "layer_kind_config_key": "circuit_layer_kinds"
    },
    "block_contract": {
      "norm_type": "grouped_rmsnorm_plus_one",
      "residual_formula": "four_stream_hyper_mix_then_weighted_block_injection",
      "mlp_formula": "topk_packed_experts_plus_sigmoid_gated_shared_swiglu",
      "activation": "swiglu",
      "body_type": "qwen4_exp_hybrid"
    },
    "logits_contract": {
      "final_norm": "hyper_connection_mix_without_injection",
      "lm_head": "untied_or_weight_tying",
      "logits_layout": "last"
    },
    "quant_contract": {
      "kernel_select": "weight_dtype_registry",
      "activation_dtype": "contract_selected",
      "per_tensor_mixed_quant": true
    },
    "runtime_invariants": {"required_call_args": {}}
  },
  "required_contracts": {
    "decoder.attention": {
      "op": "attention",
      "template_ops": ["attn"],
      "selector": {
        "config_not_equals": {
          "decode_kv_cache_dtype": "bf16"
        }
      },
      "phases": {
        "prefill": {
          "requires": {
            "execution.phase": "prefill",
            "execution.prefill_batching": "batch_append",
            "tensor.q.dtype": "fp32",
            "tensor.kv.dtype": "fp16",
            "tensor.layout": "head_major",
            "numerics.attention_reduction": "f16_flash_auto_qtile64"
          },
          "validation": "observed",
          "evidence": "Quantized Qwen4-Exp writes K/V through llama.cpp-compatible FP16 cache storage before full-attention prefill."
        },
        "decode": {
          "requires": {
            "execution.phase": "decode",
            "tensor.q.dtype": "fp32",
            "tensor.kv.dtype": "fp16",
            "tensor.layout": "head_major",
            "numerics.attention_reduction": "f16_online_fp32_merge"
          },
          "validation": "observed",
          "evidence": "Quantized Qwen4-Exp decode reads the same llama.cpp-compatible FP16 K/V cache."
        }
      }
    },
    "decoder.attention_bf16_pytorch": {
      "op": "attention",
      "template_ops": ["attn"],
      "selector": {
        "config_equals": {
          "decode_kv_cache_dtype": "bf16"
        }
      },
      "phases": {
        "prefill": {
          "requires": {
            "execution.phase": "prefill",
            "execution.prefill_batching": "unified_mixed",
            "execution.attention_schedule": "full_matrix_causal",
            "tensor.q.dtype": "fp32",
            "tensor.kv.dtype": "bf16",
            "tensor.layout": "head_major",
            "numerics.attention_reduction": "bf16_pytorch_sdpa"
          },
          "validation": "validated",
          "evidence": "BF16 Qwen4-Exp full-attention prefill preserves PyTorch BF16 K/V storage and SDPA arithmetic."
        },
        "decode": {
          "requires": {
            "execution.phase": "decode",
            "tensor.q.dtype": "fp32",
            "tensor.kv.dtype": "bf16",
            "tensor.layout": "head_major",
            "numerics.attention_reduction": "bf16_pytorch_sdpa"
          },
          "validation": "validated",
          "evidence": "BF16 Qwen4-Exp incremental decode preserves the PyTorch BF16 K/V storage boundary."
        }
      }
    }
  },
  "required_numerical_contracts": {
