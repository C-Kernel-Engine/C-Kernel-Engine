{
  "id": "rope_forward_qk_split_direct",
  "op": "rope",
  "operation_interface": "rope.split_direct.fp32.v1",
  "selection": {"status": "production", "priority": 100, "equivalence_group": "rope.split_direct.fp32.v1", "phases": ["prefill", "decode"]},
  "variant": "fp32_head_major_split_half_direct",
  "quant": {
