    {"name": "pos_offset", "dtype": "int32", "desc": "Absolute position offset"},
    {"name": "rotary_dim", "dtype": "int32", "desc": "RoPE rotary dimensions (only rotate first rotary_dim channels)"},
    {"name": "freq_base", "dtype": "float32", "source": "dim:rope_freq_base", "desc": "Per-layer RoPE theta/base"}
